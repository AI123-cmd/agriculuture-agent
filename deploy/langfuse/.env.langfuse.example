# Langfuse 私有化部署的环境变量模板（T6-07）
#
# 用法：复制为 deploy/langfuse/.env（已被 .gitignore 忽略），填入真实随机值后启动：
#   docker compose -f deploy/langfuse/docker-compose.langfuse.yml \
#     --env-file deploy/langfuse/.env up -d
#
# 本文件是提交物，**不得写入真实密钥**。下面四项没有默认值，未填时 Compose 直接报错
# 终止——官方说这三项"测试可跳过、存敏感数据必须改"，而本项目存的是真实农事数据，不可跳过。

# 加盐值，至少 32 字符。用于哈希用户标识等可关联字段，泄露后可被离线枚举反推。
# 生成：openssl rand -base64 48
LANGFUSE_SALT=

# 加密密钥，必须用 openssl rand -base64 32 生成（Langfuse 要求 32 字节）。
# 它加密库中保存的第三方凭据；**一旦更换，已存的加密字段全部无法解密**，
# 因此升级前必须备份本值，不要随镜像更新一起轮换。
LANGFUSE_ENCRYPTION_KEY=

# NextAuth 会话签名密钥。生成：openssl rand -base64 48
LANGFUSE_NEXTAUTH_SECRET=

# 界面基址。同一 Compose 网络内反代访问时填反代后的地址（如 https://langfuse.example.com）。
# 本机调试可留 http://localhost:3000（需临时自行加 ports 映射，见 README 第二节）。
LANGFUSE_NEXTAUTH_URL=

# ---- 以下为依赖组件的口令。同样不得留空或使用示例值 ----
# PostgreSQL（Langfuse 元数据）
LANGFUSE_POSTGRES_PASSWORD=
# ClickHouse（观测事件存储，数据量最大）
LANGFUSE_CLICKHOUSE_PASSWORD=
# Redis（队列与缓存）
LANGFUSE_REDIS_PASSWORD=
# MinIO（事件与多模态大对象）
LANGFUSE_MINIO_USER=
LANGFUSE_MINIO_PASSWORD=

# ---- 可选 ----
# Langfuse 自身 span 上报到自建 collector 的端点（如 http://otel-collector:4317）。
# 留空则不上报自身，统一 APM 里看不到 Langfuse 自己的运维指标。
OTEL_COLLECTOR_ENDPOINT=
