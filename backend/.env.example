# 服务配置
APP_NAME=话农点金
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库（MySQL 8.0）
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/huanong

# Redis（可选，留空则使用进程内内存做 token 会话）
REDIS_URL=

# Token 有效期（秒），默认 7 天
TOKEN_EXPIRE_SECONDS=604800

# 微信小程序凭证（请填写你自己的的值）
# 注意：本文件是会被提交的模板，切勿在此写入真实 AppID / AppSecret，请复制到 .env（已被忽略）后填写
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 农业大模型 API（配置后自动关闭 Mock）
FARM_LLM_API_URL=
FARM_API_KEY=
USE_MOCK_LLM=true

# 逆地理编码（腾讯/高德地图）
GEOCODING_API_URL=
GEOCODING_API_KEY=

# 天气
WEATHER_API_URL=
WEATHER_API_KEY=

# 对象存储（local / oss / cos）
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads

# 质量评估阈值
HARNESS_PASS_RATE_THRESHOLD=0.90