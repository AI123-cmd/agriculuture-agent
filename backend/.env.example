# 服务配置
APP_NAME=话农点金
# ENV 取值只能是 development / staging / production（pydantic-settings 启动时校验拼写）
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 数据库（PostgreSQL 16+，需带 pgvector 与 timescaledb 扩展）
# DATABASE_URL 给 SQLAlchemy 异步引擎，driver 必须是 asyncpg
DATABASE_URL=postgresql+asyncpg://huanong:huanong@localhost:5432/huanong
# CHECKPOINT_DB_URL 给 psycopg 连接池（LangGraph 检查点），driver 为裸 postgresql（即 psycopg v3）
# 两者 driver 前缀不同是刻意的：asyncpg 不被 psycopg 连接池支持，psycopg 不被异步引擎使用
CHECKPOINT_DB_URL=postgresql://huanong:huanong@localhost:5432/huanong
CHECKPOINT_SCHEMA=checkpoint
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 检查点连接池上限
CHECKPOINT_POOL_MAX=10

# 知识条目向量维度，必须与 T2-56 选定的 embedding 模型输出维度一致
EMBEDDING_DIM=1024

# 缓存与队列（Redis 7+）
# 生产环境 REDIS_URL 必填，为空时启动自检拒绝启动；开发环境可退化为进程内集合
REDIS_URL=
REDIS_REQUIRED=false

# Token 有效期（秒），默认 7 天
TOKEN_EXPIRE_SECONDS=604800

# 认证密钥（必须走密钥管理，不要写进本模板的提交物）
JWT_SECRET=
JWT_ALGORITHM=HS256

# 安全闸门模式。灰度期用 ENV=staging + GATE_MODE=shadow；
# 全量切生产时必须把 GATE_MODE 改为 enforce，否则启动自检拒绝启动
GATE_MODE=shadow

# CORS 白名单（逗号分隔或 JSON 数组）。小程序端不受同源策略约束，
# 此项只影响 Web 调试页与后台管理页；生产环境为空或含 * 时启动自检拒绝启动
CORS_ORIGINS=

# 微信小程序凭证（请填写你自己的的值）
# 注意：本文件是会被提交的模板，切勿在此写入真实 AppID / AppSecret，请复制到 .env（已被忽略）后填写
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 农业大模型 API（配置后自动关闭 Mock）
FARM_LLM_API_URL=
FARM_API_KEY=
USE_MOCK_LLM=true

# 逆地理编码（腾讯/高德地图）
GEOCODING_API_URL=
GEOCODING_API_KEY=

# 天气
WEATHER_API_URL=
WEATHER_API_KEY=

# 对象存储（local / oss / cos）
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
UPLOAD_MAX_BYTES=5242880

# 质量评估阈值
HARNESS_PASS_RATE_THRESHOLD=0.90

# ---------------------------------------------------------------------------
# 必须走密钥管理的清单（只从环境变量读，绝不写进 .env 提交物）：
#   JWT_SECRET
#   WECHAT_APP_SECRET
#   FARM_API_KEY
#   WEATHER_API_KEY
#   GEOCODING_API_KEY
# ---------------------------------------------------------------------------
