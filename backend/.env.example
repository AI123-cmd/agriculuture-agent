# 服务配置
APP_NAME=话农点金
# ENV 取值只能是 development / staging / production（pydantic-settings 启动时校验拼写）
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 数据库（PostgreSQL 16+，需带 pgvector 与 timescaledb 扩展）
# DATABASE_URL 给 SQLAlchemy 异步引擎，driver 必须是 asyncpg
DATABASE_URL=postgresql+asyncpg://huanong:huanong@localhost:5432/huanong
# CHECKPOINT_DB_URL 给 psycopg 连接池（LangGraph 检查点），driver 为裸 postgresql（即 psycopg v3）
# 两者 driver 前缀不同是刻意的：asyncpg 不被 psycopg 连接池支持，psycopg 不被异步引擎使用
CHECKPOINT_DB_URL=postgresql://huanong:huanong@localhost:5432/huanong
CHECKPOINT_SCHEMA=checkpoint
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 检查点连接池上限
CHECKPOINT_POOL_MAX=10

# 知识条目向量维度，必须与 T2-56 选定的 embedding 模型输出维度一致
EMBEDDING_DIM=1024

# 缓存与队列（Redis 7+）
# 生产环境 REDIS_URL 必填，为空时启动自检拒绝启动；开发环境可退化为进程内集合
REDIS_URL=
REDIS_REQUIRED=false

# Token 有效期（秒），默认 7 天
TOKEN_EXPIRE_SECONDS=604800

# 认证密钥（必须走密钥管理，不要写进本模板的提交物）
JWT_SECRET=
JWT_ALGORITHM=HS256

# 安全闸门模式。灰度期用 ENV=staging + GATE_MODE=shadow；
# 全量切生产时必须把 GATE_MODE 改为 enforce，否则启动自检拒绝启动
GATE_MODE=shadow

# CORS 白名单（JSON 数组，或逗号分隔的字符串）。留空写 []，不要写成裸空值——
# pydantic-settings 对列表型字段先做 JSON 解析，空串会直接报 SettingsError。
# 小程序端不受同源策略约束，此项只影响 Web 调试页与后台管理页；
# 生产环境为空或含 * 时启动自检拒绝启动
CORS_ORIGINS=[]

# 微信小程序凭证（请填写你自己的的值）
# 注意：本文件是会被提交的模板，切勿在此写入真实 AppID / AppSecret，请复制到 .env（已被忽略）后填写
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 农业大模型 API（配置后自动关闭 Mock）
FARM_LLM_API_URL=
FARM_API_KEY=
USE_MOCK_LLM=true

# 逆地理编码（腾讯/高德地图）
GEOCODING_API_URL=
GEOCODING_API_KEY=

# 天气
WEATHER_API_URL=
WEATHER_API_KEY=

# 对象存储（local / oss / cos）
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
UPLOAD_MAX_BYTES=5242880

# 质量评估阈值
HARNESS_PASS_RATE_THRESHOLD=0.90

# 链路追踪（T6-06，技术方案 14.4）
# OTEL_ENABLED=false 时不注册 provider，start_as_current_span 退化为空操作，开销可忽略。
# OTEL_EXPORTER 四档：otlp（生产，指向自建 collector）、langfuse（T6-07，指向私有
# Langfuse 的 OTLP 接收端）、console（本地调试）、none（CI）。
# 生产环境 OTEL_ENABLED=true 时 OTEL_ENDPOINT 必填，否则启动自检拒绝启动——
# 避免追踪静默走控制台导出、trace 落进容器日志。
OTEL_ENABLED=false
OTEL_EXPORTER=none
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=huanong-agent

# Langfuse 私有化观测（T6-07，技术方案 14.4 与 17.2）
# 违规红线是"农事数据不外流"，故 LLM 观测必须私有化部署。部署见 deploy/langfuse/README.md。
# 启用步骤：OTEL_ENABLED=true + OTEL_EXPORTER=langfuse，并填写下面四项。
# LANGFUSE_ENABLED=false 时不构造任何客户端，上游零请求；为 true 但地址/密钥缺失或不可达
# 时静默降级——观测是旁路，不得成为可用性依赖（Langfuse 停掉业务照常跑）。
LANGFUSE_ENABLED=false
# Langfuse 地址。同一 Compose 网络内填 http://langfuse-web:3000
LANGFUSE_HOST=
# 界面创建项目后生成的密钥（走密钥管理，不要写进本模板的提交物）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 抽样比：本地 1.0 全量；生产建议 0.2（LLM 观测数据体量大，全量上报会拖垮 Langfuse 自身）。
# 抽样在根 span 创建时决定、子 span 继承，不会产生"父在子不在"的残缺 trace。
LANGFUSE_TRACE_RATIO=1.0

# ---------------------------------------------------------------------------
# 必须走密钥管理的清单（只从环境变量读，绝不写进 .env 提交物）：
#   JWT_SECRET
#   WECHAT_APP_SECRET
#   FARM_API_KEY
#   WEATHER_API_KEY
#   GEOCODING_API_KEY
#   LANGFUSE_SECRET_KEY
# ---------------------------------------------------------------------------
