{"knowledge_id": "K-TEA-0111", "process_id": "tea", "kind": "pesticide", "title": "虫螨腈防治茶小绿叶蝉", "content": "虫螨腈用于防治茶小绿叶蝉，在若虫盛期施药，注意采摘前安全间隔期。", "pesticide_name": "虫螨腈", "registered_crops": ["茶"], "dosage_min": 20.0, "dosage_max": 30.0, "dosage_unit": "毫升/亩", "safety_interval_days": 10, "max_uses_per_season": 2, "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "登记标签; TODO(待确认)"}
{"knowledge_id": "K-TEA-0112", "process_id": "tea", "kind": "pesticide", "title": "唑虫酰胺防治茶小绿叶蝉", "content": "唑虫酰胺用于防治茶小绿叶蝉，与虫螨腈轮换使用以延缓抗性。", "pesticide_name": "唑虫酰胺", "registered_crops": ["茶"], "dosage_min": 15.0, "dosage_max": 25.0, "dosage_unit": "毫升/亩", "safety_interval_days": 7, "max_uses_per_season": 2, "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "登记标签; TODO(待确认)"}
{"knowledge_id": "K-TEA-0113", "process_id": "tea", "kind": "pesticide", "title": "联苯菊酯防治茶尺蠖", "content": "联苯菊酯用于防治茶尺蠖，在低龄幼虫期施药效果较好。", "pesticide_name": "联苯菊酯", "registered_crops": ["茶"], "dosage_min": 12.5, "dosage_max": 15.0, "dosage_unit": "毫升/亩", "safety_interval_days": 7, "max_uses_per_season": 1, "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "登记标签; TODO(待确认)"}
