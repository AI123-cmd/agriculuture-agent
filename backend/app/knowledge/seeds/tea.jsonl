{"knowledge_id": "K-TEA-0101", "process_id": "tea", "kind": "disease", "title": "茶云纹叶枯病识别", "content": "叶片上出现半圆形或不规则形褐色病斑，病健交界明显，后期病斑中央灰白色并生黑色小点。多雨高湿季节易流行。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研 2024"}
{"knowledge_id": "K-TEA-0102", "process_id": "tea", "kind": "pest", "title": "茶小绿叶蝉识别", "content": "成若虫刺吸嫩梢汁液，受害芽叶叶缘变黄、叶尖焦枯，叶片卷曲硬化，嫩梢生长停滞。若虫期用药效果最好。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研 2024"}
{"knowledge_id": "K-TEA-0103", "process_id": "tea", "kind": "pest", "title": "茶尺蠖识别", "content": "低龄幼虫咬食叶片成网状，高龄幼虫将叶片吃成缺刻甚至光秃，幼虫受惊时吐丝下垂。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研 2024"}
{"knowledge_id": "K-TEA-0104", "process_id": "tea", "kind": "pest", "title": "茶橙瘿螨识别", "content": "成若螨刺吸叶片汁液，叶片失去光泽、变黄变红，叶背可见细小螨体与白色蜕皮。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研 2024"}
{"knowledge_id": "K-TEA-0105", "process_id": "tea", "kind": "threshold", "title": "茶小绿叶蝉叶发病率防治指标", "content": "叶发病率即受该虫危害的芽叶占调查芽叶总数的比例。春茶期叶发病率达 10% 或百芽虫量达 6 头时，达到防治指标。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研 2024"}
{"knowledge_id": "K-TEA-0106", "process_id": "tea", "kind": "threshold", "title": "茶尺蠖防治指标（虫口密度）", "content": "成龄茶园每平方米虫口数达 7 头，幼龄茶园达 4 头时，达到防治指标。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研 2024"}
{"knowledge_id": "K-TEA-0107", "process_id": "tea", "kind": "pesticide", "title": "乙酰甲胺磷（禁限用）", "content": "乙酰甲胺磷在茶叶上属禁限用品种，已停止登记并禁止使用，不得推荐。条目保留用于历史处方追溯。", "pesticide_name": "乙酰甲胺磷", "registered_crops": ["茶"], "dosage_min": 0.0, "dosage_max": 0.0, "dosage_unit": "克/亩", "safety_interval_days": 0, "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "suspended", "status_reason": "茶叶禁限用品种（法定禁用，长期有效），依据 NY/T 4803 附录B，不得推荐", "source_ref": "NY/T 4803 附录B; TODO(待确认)"}
