{"knowledge_id": "K-RAPE-0101", "process_id": "rapeseed", "kind": "cultivation", "title": "菌核病防治窗口", "content": "油菜花期是菌核病防治关键窗口，以花期降水与田间湿度为主要判据：花期连续阴雨、田间湿度大时病害流行风险高，此时应以清沟排水、降低田间湿度为重点。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研（待补齐）；产品说明书 5.4"}
{"knowledge_id": "K-RAPE-0102", "process_id": "rapeseed", "kind": "disease", "title": "油菜菌核病识别", "content": "由核盘菌引起，茎秆出现水渍状浅褐色病斑，后变灰白色并生白色絮状菌丝，病部以上枯死，茎秆内部可见鼠粪状黑色菌核。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研（待补齐）"}
{"knowledge_id": "K-RAPE-0103", "process_id": "rapeseed", "kind": "disease", "title": "油菜霜霉病识别", "content": "叶片初生淡黄色不规则斑，后扩大成黄褐色，叶背生白色霜状霉层，严重时叶片枯死；花梗受害呈龙头状肿胀。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研（待补齐）"}
{"knowledge_id": "K-RAPE-0104", "process_id": "rapeseed", "kind": "pest", "title": "油菜蚜虫识别", "content": "蚜虫群集于嫩梢、花蕾与叶背刺吸汁液，导致叶片卷曲、花蕾脱落，同时传播病毒病。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研（待补齐）"}
{"knowledge_id": "K-RAPE-0105", "process_id": "rapeseed", "kind": "pest", "title": "油菜跳甲识别", "content": "成虫咬食叶片成密集小孔，幼苗受害尤重；幼虫在根部取食造成根部损伤。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研（待补齐）"}
{"knowledge_id": "K-RAPE-0106", "process_id": "rapeseed", "kind": "cultivation", "title": "油菜后茬关系与轮作建议", "content": "油菜不宜与十字花科作物连作，避免菌核病等土传病害累积；与禾本科作物轮作可打断病害循环。前茬收获后及时翻耕，减少菌核越冬基数。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研（待补齐）"}
{"knowledge_id": "K-RAPE-0107", "process_id": "rapeseed", "kind": "cultivation", "title": "油菜花期田间管理要点", "content": "花期保持田间排水通畅，雨后及时清沟排渍；合理密植保证通风透光；及时摘除病叶病株并带出田外处理。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研（待补齐）"}
{"knowledge_id": "K-RAPE-0108", "process_id": "rapeseed", "kind": "pesticide", "title": "油菜安全间隔期参考（待确认）", "content": "油菜用药的安全间隔期需按具体登记药剂核对，此处仅作占位参考，调研补齐前不得作为处方依据。", "pesticide_name": "待确认", "registered_crops": ["油菜"], "dosage_min": 0.0, "dosage_max": 0.0, "dosage_unit": "克/亩", "safety_interval_days": 0, "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "draft", "source_ref": "专项调研（待补齐）；产品说明书 5.4"}
