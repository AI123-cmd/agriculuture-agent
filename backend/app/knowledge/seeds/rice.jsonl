{"knowledge_id": "K-RICE-0101", "process_id": "rice", "kind": "disease", "title": "稻瘟病（苗瘟期）识别", "content": "苗瘟多在 3 叶期前后发生，病苗基部变黑、上部变褐枯死，湿度大时病部生灰绿色霉层。防治以选用抗病品种与种子处理为主。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研 2024; 本地植保站资料"}
{"knowledge_id": "K-RICE-0102", "process_id": "rice", "kind": "disease", "title": "稻瘟病（叶瘟期）识别", "content": "慢性型病斑呈梭形、中央灰白边缘褐色，急性型病斑暗绿近圆形，湿度大时叶背生灰绿色霉层。急性型病斑出现是病害流行的征兆。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研 2024; 本地植保站资料"}
{"knowledge_id": "K-RICE-0103", "process_id": "rice", "kind": "disease", "title": "稻瘟病（穗颈瘟）识别", "content": "穗颈受害处变褐缩缢，轻者秕谷增多，重者全穗变白形成白穗。抽穗期遇连续阴雨易流行。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研 2024; 本地植保站资料"}
{"knowledge_id": "K-RICE-0104", "process_id": "rice", "kind": "disease", "title": "纹枯病识别", "content": "叶鞘近水面处出现云纹状病斑，边缘褐色中央灰绿，湿度大时病部生白色菌丝并结褐色菌核。重发田块可致倒伏。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研 2024; 本地植保站资料"}
{"knowledge_id": "K-RICE-0105", "process_id": "rice", "kind": "disease", "title": "稻曲病识别", "content": "抽穗后穗部个别谷粒颖壳张开，内部充满橙黄至墨绿色孢子球，后期孢子球表面龟裂散出墨绿色粉末。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研 2024; 本地植保站资料"}
{"knowledge_id": "K-RICE-0106", "process_id": "rice", "kind": "pest", "title": "稻飞虱识别", "content": "成虫与若虫聚集在稻丛基部刺吸汁液，重发田块下部叶片发黄、成片冒穿倒伏，基部可见大量虫体与蜜露。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研 2024; 本地植保站资料"}
{"knowledge_id": "K-RICE-0107", "process_id": "rice", "kind": "pest", "title": "二化螟识别", "content": "幼虫蛀入茎秆取食，分蘖期造成枯心苗，孕穗后造成枯孕穗与白穗，茎秆上可见蛀入孔与虫粪。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研 2024; 本地植保站资料"}
{"knowledge_id": "K-RICE-0108", "process_id": "rice", "kind": "pest", "title": "稻纵卷叶螟识别", "content": "幼虫吐丝将叶片纵卷成筒状并在其中取食叶肉，留下白色下表皮，受害田块远看一片灰白。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "专项调研 2024; 本地植保站资料"}
{"knowledge_id": "K-RICE-0109", "process_id": "rice", "kind": "threshold", "title": "稻瘟病叶瘟防治指标", "content": "分蘖期病叶率达 5%，或田间出现急性型病斑时，即应施药防治。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "本地植保站资料"}
{"knowledge_id": "K-RICE-0110", "process_id": "rice", "kind": "threshold", "title": "稻飞虱防治指标（百丛虫量）", "content": "分蘖期百丛虫量达 1000 头，孕穗后百丛虫量达 1500 头时，达到防治指标。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "本地植保站资料"}
{"knowledge_id": "K-RICE-0111", "process_id": "rice", "kind": "threshold", "title": "纹枯病防治指标（病丛率）", "content": "分蘖末期至孕穗期病丛率达 20% 时，达到防治指标。", "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "本地植保站资料"}
{"knowledge_id": "K-RICE-0112", "process_id": "rice", "kind": "pesticide", "title": "吡虫啉（抗药性暂停名单）", "content": "吡虫啉曾用于防治稻飞虱。因褐飞虱已产生高水平抗药性，现列入抗药性暂停名单，暂停在水稻上使用，待抗性回落与主管部门解除后恢复。", "pesticide_name": "吡虫啉", "registered_crops": ["水稻"], "dosage_min": 8.0, "dosage_max": 12.0, "dosage_unit": "克/亩", "safety_interval_days": 14, "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "suspended", "status_reason": "褐飞虱对吡虫啉已产生高水平抗药性，列入抗药性暂停名单（暂停使用，非删除，便于历史追溯）", "source_ref": "植保站通报; 需人工确认"}
{"knowledge_id": "K-RICE-0113", "process_id": "rice", "kind": "cultivation", "title": "稻渔共养区用药禁忌", "content": "稻渔共养区禁用对鱼类高毒的杀虫剂，包括菊酯类与部分有机磷类，施药前须确认养殖对象与水渠连通情况。", "forbidden_combinations": ["稻渔共养区禁用菊酯类杀虫剂", "稻渔共养区禁用有机磷类杀虫剂"], "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "draft", "source_ref": "专项调研; TODO(待确认)"}
{"knowledge_id": "K-RICE-0114", "process_id": "rice", "kind": "cultivation", "title": "稻虾共养区用药禁忌", "content": "稻虾共养区禁用对虾高毒药剂，尤其避免在虾蜕壳期施药，施药后短期内不排水。", "forbidden_combinations": ["稻虾共养区禁用对虾高毒药剂"], "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "draft", "source_ref": "专项调研; TODO(待确认)"}
{"knowledge_id": "K-RICE-0115", "process_id": "rice", "kind": "pesticide", "title": "三氟苯嘧啶防治稻飞虱", "content": "三氟苯嘧啶用于防治稻飞虱，注意与不同作用机理药剂轮换，以延缓抗性产生。", "pesticide_name": "三氟苯嘧啶", "registered_crops": ["水稻"], "dosage_min": 10.0, "dosage_max": 12.0, "dosage_unit": "克/亩", "safety_interval_days": 21, "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "登记标签"}
{"knowledge_id": "K-RICE-0116", "process_id": "rice", "kind": "pesticide", "title": "氯虫苯甲酰胺防治二化螟", "content": "氯虫苯甲酰胺用于防治二化螟，宜在卵孵化高峰期施药。", "pesticide_name": "氯虫苯甲酰胺", "registered_crops": ["水稻"], "dosage_min": 10.0, "dosage_max": 15.0, "dosage_unit": "毫升/亩", "safety_interval_days": 14, "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "登记标签"}
{"knowledge_id": "K-RICE-0117", "process_id": "rice", "kind": "pesticide", "title": "稻瘟灵防治稻瘟病", "content": "稻瘟灵用于防治稻瘟病，穗颈瘟应在破口前 3 至 5 天施药。", "pesticide_name": "稻瘟灵", "registered_crops": ["水稻"], "dosage_min": 100.0, "dosage_max": 150.0, "dosage_unit": "毫升/亩", "safety_interval_days": 21, "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "登记标签"}
{"knowledge_id": "K-RICE-0118", "process_id": "rice", "kind": "pesticide", "title": "噻呋酰胺防治纹枯病", "content": "噻呋酰胺用于防治纹枯病，宜在病丛率达到防治指标时施药，重点喷施稻株中下部。", "pesticide_name": "噻呋酰胺", "registered_crops": ["水稻"], "dosage_min": 20.0, "dosage_max": 25.0, "dosage_unit": "毫升/亩", "safety_interval_days": 21, "region_scope": null, "regions": [{"region_code": "000000", "region_level": "national"}], "status": "approved", "source_ref": "登记标签"}
