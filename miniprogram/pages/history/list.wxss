@import '../../styles/tokens.wxss';
/* pages/history/list.wxss */
page {
  background: var(--bg-page);
}

.history-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
}

/* 头部 */
.header {
  position: relative;
  background: var(--grad-header);
  padding-top: calc(110rpx + env(safe-area-inset-top));
  padding-bottom: 32rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  min-height: calc(230rpx + env(safe-area-inset-top));
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.18);
}

.header-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.deco-1 {
  width: 200rpx;
  height: 200rpx;
  right: -40rpx;
  top: -60rpx;
}

.deco-2 {
  width: 100rpx;
  height: 100rpx;
  right: 120rpx;
  bottom: -30rpx;
  background: rgba(255, 255, 255, 0.06);
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.header-title {
  font-size: var(--font-title);
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  line-height: var(--line-tight);
}

.header-sub {
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.85);
  line-height: var(--line-tight);
}

.new-chat-btn {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.22);
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  min-height: var(--tap-min);
  box-sizing: border-box;
  transition: background 0.15s ease;
}

.new-chat-btn:active {
  background: rgba(255, 255, 255, 0.34);
}

.plus-icon {
  font-size: var(--font-title);
  color: #fff;
  font-weight: 300;
}

.new-chat-text {
  font-size: var(--font-body);
  color: #fff;
}

/* 历史列表 */
.history-scroll {
  flex: 1;
  overflow: hidden;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.history-list {
  padding: 24rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.conversation-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #fff;
  gap: 24rpx;
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s ease;
}

.conversation-item:active {
  transform: scale(0.98);
}

.conv-icon {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.conv-content {
  flex: 1;
  min-width: 0;
}

.conv-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  line-height: var(--line-tight);
}

.conv-preview {
  font-size: var(--font-caption);
  color: #595959;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conv-delete {
  width: var(--tap-min);
  height: var(--tap-min);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  opacity: 0.5;
}

.conv-delete:active {
  opacity: 1;
}

.delete-icon {
  font-size: var(--font-body);
  color: #595959;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 160rpx;
  gap: 20rpx;
}

.empty-mascot {
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: #7a8577;
  line-height: var(--line-tight);
}

.empty-text {
  font-size: var(--font-body);
  color: #595959;
}

.empty-btn {
  margin-top: 24rpx;
  background: var(--grad-brand);
  border-radius: 999rpx;
  padding: 20rpx 48rpx;
  min-height: var(--btn-primary-height);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-btn);
}

.empty-btn:active {
  transform: scale(0.97);
}

.empty-btn-text {
  font-size: var(--font-body);
  color: #fff;
  font-weight: 500;
}
