@import '../../styles/tokens.wxss';
/* pages/history/list.wxss */
page {
  background: #f0f4ea;
}

.history-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f0f4ea;
}

/* 头部 */
.header {
  position: relative;
  background: linear-gradient(150deg, #43a047 0%, #2e7d32 55%, #1f5c24 100%);
  padding-top: calc(110rpx + env(safe-area-inset-top));
  padding-bottom: 32rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  min-height: calc(230rpx + env(safe-area-inset-top));
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 0 0 36rpx 36rpx;
}

.header-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.deco-1 {
  width: 200rpx;
  height: 200rpx;
  right: -40rpx;
  top: -60rpx;
}

.deco-2 {
  width: 100rpx;
  height: 100rpx;
  right: 120rpx;
  bottom: -30rpx;
  background: rgba(255, 255, 255, 0.06);
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.header-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.4;
}

.new-chat-btn {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.plus-icon {
  font-size: 32rpx;
  color: #fff;
  font-weight: 300;
}

.new-chat-text {
  font-size: 28rpx;
  color: #fff;
}

/* 历史列表 */
.history-scroll {
  flex: 1;
  overflow: hidden;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.history-list {
  padding: 24rpx 0;
}

.conversation-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #fff;
  gap: 24rpx;
}

.conv-icon {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.conv-content {
  flex: 1;
  min-width: 0;
}

.conv-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.conv-preview {
  font-size: 26rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conv-delete {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  opacity: 0.4;
}

.conv-delete:active {
  opacity: 1;
}

.delete-icon {
  font-size: 28rpx;
  color: #999;
}

.conv-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin-left: 144rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 160rpx;
  gap: 20rpx;
}

.empty-mascot {
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #7a8577;
}

.empty-text {
  font-size: 26rpx;
  color: #9aa39a;
}

.empty-btn {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #43a047, #2e7d32);
  border-radius: 44rpx;
  padding: 20rpx 48rpx;
  box-shadow: 0 8rpx 20rpx rgba(46, 125, 50, 0.25);
}

.empty-btn:active {
  transform: scale(0.97);
}

.empty-btn-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}
