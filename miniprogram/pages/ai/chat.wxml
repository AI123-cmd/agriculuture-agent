<!--pages/ai/chat.wxml-->
<view class="chat-page">
  <view class="header">
    <view class="header-deco deco-1"></view>
    <view class="header-deco deco-2"></view>
    <view class="header-content">
      <sprout-mascot size="{{88}}" />
      <view class="header-text">
        <view class="header-title">AI 农事顾问</view>
        <view class="header-sub">{{stageLabel || '小禾随时为您解答种植难题'}}{{progressText ? ' · ' + progressText : ''}}</view>
      </view>
    </view>
  </view>

  <!-- 作物标签条：作为问诊的流程提示（processHint）传入后端 -->
  <view class="crop-tag-bar">
    <view class="crop-tag-left">
      <text class="crop-tag-label t-caption">当前咨询</text>
      <view class="crop-tag-current t-body">{{currentCropName}}</view>
    </view>
    <view class="crop-tag-switch tap-88" bindtap="showCropSwitch">
      <text class="switch-text t-caption">切换</text>
      <text class="switch-arrow">›</text>
    </view>
  </view>

  <scroll-view class="chat-scroll" scroll-y scroll-top="{{scrollTop}}" scroll-with-animation="{{scrollWithAnimation}}" enhanced show-scrollbar="{{false}}">
    <view class="chat-list">
      <block wx:for="{{messages}}" wx:key="id">
        <!-- AI 消息（左侧） -->
        <view wx:if="{{item.role === 'ai'}}" class="msg-row ai-row">
          <view class="msg-content ai-content">
            <view class="msg-bubble ai-bubble t-body">{{item.content}}</view>
            <!-- 转人工消息用独立朗读按钮，文案更明确 -->
            <view wx:if="{{item.speakable}}" class="tip-read-btn tap-88" data-index="{{index}}" bindtap="playVoice">
              <text class="tip-read-icon">读</text>
            </view>
            <view wx:elif="{{item.showVoice}}" class="voice-play-btn tap-88" data-index="{{index}}" bindtap="playVoice">
              <view class="vp-icon">
                <view class="vp-speaker"></view>
                <view class="vp-wave vp-wave-1"></view>
                <view class="vp-wave vp-wave-2"></view>
                <view class="vp-wave vp-wave-3"></view>
              </view>
            </view>
          </view>
        </view>

        <!-- 用户消息（右侧） -->
        <view wx:if="{{item.role === 'user'}}" class="msg-row user-row">
          <view class="msg-content user-content">
            <view wx:if="{{item.image}}" class="user-photo tap-88" data-url="{{item.image}}" bindtap="previewPhoto">
              <image class="user-photo-img" src="{{item.image}}" mode="aspectFill" />
            </view>
            <view class="msg-bubble user-bubble t-body">{{item.content}}</view>
          </view>
        </view>
      </block>

      <!-- 追问：多张卡片需全部答完才自动提交（一次一步的历史行为已取消） -->
      <view class="qa-block" wx:if="{{questions.length > 0}}">
        <view class="qa-progress t-caption" wx:if="{{questions.length > 1}}">请依次作答（{{qaAnswered}}/{{questions.length}}），全部答完后自动提交</view>
        <view class="qa-item card {{item.picked ? 'picked' : ''}}" wx:for="{{questions}}" wx:key="slotKey">
          <view class="qa-text t-body">{{item.text}}</view>
          <view class="qa-why t-caption" wx:if="{{item.why}}">{{item.why}}</view>
          <!-- 拍照作答：仅 photo 类型的追问出现，照片本身就是该题的答案 -->
          <view class="qa-photo-area" wx:if="{{item.answerType === 'photo'}}">
            <view
              class="qa-photo-btn tap-88 {{item.picked ? 'selected' : ''}}"
              bindtap="onQaPhoto"
              data-slot="{{item.slotKey}}"
            >
              <view class="photo-glyph"></view>
              <text class="qa-photo-text t-body">{{item.photoUrl ? '已拍照，点击重拍' : '拍张照片说明情况'}}</text>
            </view>
            <view class="user-photo" wx:if="{{item.photoUrl}}" data-url="{{item.photoUrl}}" bindtap="previewPhoto">
              <image class="user-photo-img" src="{{item.photoUrl}}" mode="aspectFill" />
            </view>
          </view>
          <view class="qa-options">
            <view
              class="qa-option tap-88 {{item.picked && item.pickedOption === opt ? 'selected' : ''}}"
              wx:for="{{item.options}}"
              wx:for-item="opt"
              wx:key="*this"
              bindtap="onAnswerOption"
              data-slot="{{item.slotKey}}"
              data-value="{{opt}}"
            >{{opt}}</view>
            <view
              class="qa-option qa-unknown tap-88 {{item.picked && item.pickedStatus === 'unknown' ? 'selected' : ''}}"
              wx:if="{{item.allowUnknown}}"
              bindtap="onAnswerUnknown"
              data-slot="{{item.slotKey}}"
            >说不清</view>
          </view>
          <!-- 自由文本作答：选项不全或只有"说不清"时，农户可直接打字描述（拍照题除外） -->
          <view class="qa-input-row" wx:if="{{item.answerType !== 'photo'}}">
            <view class="qa-input-box">
              <input
                class="qa-input"
                placeholder="也可以直接打字说明..."
                value="{{item.inputValue}}"
                confirm-type="done"
                bindinput="onQaInput"
                bindconfirm="onQaTextConfirm"
                data-slot="{{item.slotKey}}"
              />
            </view>
            <view
              class="qa-input-send tap-88 {{item.inputValue ? 'active' : ''}}"
              bindtap="onQaTextConfirm"
              data-slot="{{item.slotKey}}"
            >确定</view>
          </view>
        </view>
      </view>

      <!-- 处方结论 -->
      <view class="rx-card card" wx:if="{{prescription}}">
        <view class="card-title">处置建议</view>
        <view class="rx-summary t-body">{{prescription.diagnosisSummary}}</view>

        <view class="rx-section" wx:if="{{prescription.actions.length > 0}}">
          <view class="rx-section-title t-title">怎么做</view>
          <view class="rx-action" wx:for="{{prescription.actions}}" wx:key="order">
            <view class="rx-action-main t-body">{{item.order}}. {{item.action}}</view>
            <view class="rx-action-meta t-caption" wx:if="{{item.timing}}">时间：{{item.timing}}</view>
            <view class="rx-action-meta t-caption" wx:if="{{item.method}}">方法：{{item.method}}</view>
            <view class="rx-action-meta t-caption" wx:for="{{item.cautions}}" wx:for-item="c" wx:key="*this">注意：{{c}}</view>
          </view>
        </view>

        <view class="rx-section" wx:if="{{prescription.pesticideItems.length > 0}}">
          <view class="rx-section-title t-title">用药</view>
          <view class="rx-pesticide" wx:for="{{prescription.pesticideItems}}" wx:key="name">
            <view class="rx-pesticide-name t-body">{{item.name}}</view>
            <view class="rx-action-meta t-caption" wx:if="{{item.safetyIntervalDays}}">安全间隔：{{item.safetyIntervalDays}} 天</view>
            <view class="rx-action-meta t-caption" wx:if="{{item.sourceNote}}">{{item.sourceNote}}</view>
          </view>
        </view>

        <view class="rx-section" wx:if="{{prescription.followupPlan.tasks.length > 0}}">
          <view class="rx-section-title t-title">后续观察</view>
          <view class="rx-action-meta t-caption" wx:for="{{prescription.followupPlan.tasks}}" wx:key="dueOffsetDays">
            {{item.dueOffsetDays}} 天后：{{item.ask || '观察效果'}}
          </view>
        </view>

        <view class="rx-tech t-caption" wx:if="{{prescription.requiresTechStation}}">本情况建议同时咨询当地农技站。</view>

        <!-- 存入台账：仅当后端下发了处方卡 id 时渲染（当前后端未下发，按钮自动隐藏） -->
        <view
          class="rx-ledger-btn {{ledgerSaved ? 'saved' : ''}}"
          wx:if="{{prescription.cardId}}"
          bindtap="onSaveLedger"
        >{{ledgerSaved ? '已存入台账' : '存入农事台账'}}</view>
      </view>

      <!-- 转人工 -->
      <view class="handoff-card card" wx:if="{{handoff}}">
        <view class="card-title">建议找农技人员</view>
        <view class="rx-summary t-body">{{handoff.summary}}</view>
        <view class="handoff-points" wx:if="{{handoff.observationPoints.length > 0}}">
          <view class="rx-action-meta t-caption" wx:for="{{handoff.observationPoints}}" wx:key="*this">{{item}}</view>
        </view>
        <view class="handoff-contact" wx:for="{{handoff.contacts}}" wx:key="name">
          <view class="rx-pesticide-name t-body">{{item.name}}</view>
          <view class="rx-action-meta t-caption" wx:if="{{item.phone}}">{{item.phone}}</view>
        </view>
        <view class="tip-read-btn tap-88" wx:if="{{handoff.speakable}}" bindtap="playHandoff">
          <text class="tip-read-icon">读</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 输入区域：语音为主入口，打字为备选 -->
  <view class="input-bar">
    <view class="voice-btn tap-88"
          bindtouchstart="onVoiceStart"
          bindtouchend="onVoiceEnd"
          bindtouchcancel="onVoiceEnd">
      <view class="voice-icon {{recording ? 'recording' : ''}}">
        <view class="voice-glyph">
          <view class="voice-glyph-arc"></view>
        </view>
      </view>
    </view>
    <view class="photo-btn tap-88" bindtap="onChoosePhoto">
      <view class="photo-icon">
        <view class="photo-glyph"></view>
      </view>
    </view>
    <view class="input-wrap">
      <input class="msg-input t-body"
             placeholder="输入您的问题..."
             placeholder-class="msg-input-ph"
             value="{{inputValue}}"
             confirm-type="send"
             adjust-position="{{false}}"
             bindconfirm="sendMessage"
             bindinput="onInput" />
    </view>
    <view class="send-btn tap-88" bindtap="sendMessage">
      <view class="send-icon {{inputValue ? 'active' : ''}}">
        <view class="send-glyph"></view>
      </view>
    </view>
  </view>

  <!-- 等待浮层：替代原生 wx.showLoading 灰盒，小禾陪伴式等待 -->
  <view class="thinking-mask" wx:if="{{thinking}}" catchtouchmove="noop">
    <view class="thinking-card">
      <view class="thinking-stage">
        <view class="thinking-ring"></view>
        <view class="thinking-ring delay"></view>
        <view class="thinking-mascot">
          <sprout-mascot size="{{132}}" />
        </view>
      </view>
      <view class="thinking-hint">{{thinkingHint}}</view>
      <view class="thinking-dots">
        <view class="tdot"></view>
        <view class="tdot"></view>
        <view class="tdot"></view>
      </view>
    </view>
  </view>
</view>
