@import '../../styles/tokens.wxss';
/* pages/ai/chat.wxss */
page {
  background: var(--bg-page);
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
}

/* 头部 */
.header {
  position: relative;
  background: var(--grad-header);
  padding-top: calc(110rpx + env(safe-area-inset-top));
  padding-bottom: 32rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  min-height: calc(230rpx + env(safe-area-inset-top));
  box-sizing: border-box;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.18);
}

.header-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.deco-1 {
  width: 200rpx;
  height: 200rpx;
  right: -40rpx;
  top: -60rpx;
}

.deco-2 {
  width: 100rpx;
  height: 100rpx;
  right: 120rpx;
  bottom: -30rpx;
  background: rgba(255, 255, 255, 0.06);
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.header-title {
  font-size: var(--font-title);
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  line-height: var(--line-tight);
}

.header-sub {
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.85);
  line-height: var(--line-tight);
}

/* —— 作物标签条 —— */
.crop-tag-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #e4ebdd;
  flex-shrink: 0;
}

.crop-tag-left {
  display: flex;
  align-items: center;
}

.crop-tag-label {
  color: #595959;
  margin-right: 16rpx;
}

.crop-tag-current {
  font-weight: 600;
  color: #ffffff;
  background: var(--grad-brand);
  padding: 6rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.2);
}

.crop-tag-switch {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.switch-text {
  color: #2e7d32;
}

.switch-arrow {
  font-size: var(--font-body);
  color: #2e7d32;
  font-weight: 300;
  line-height: var(--line-tight);
}

/* 消息列表 */
.chat-scroll {
  flex: 1;
  width: 100%;
  height: calc(100vh - 310rpx - env(safe-area-inset-top));
  background: var(--bg-page);
  padding: 24rpx 24rpx calc(260rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.chat-list {
  padding-bottom: 24rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
}

.msg-row.ai-row {
  flex-direction: row;
}

.msg-row.user-row {
  flex-direction: row-reverse;
}

.msg-content {
  display: flex;
  align-items: flex-end;
  max-width: 75%;
  margin: 0 16rpx;
}

.ai-content {
  flex-direction: row;
  align-items: flex-end;
}

.user-content {
  flex-direction: row-reverse;
}

.msg-bubble {
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  word-break: break-all;
  white-space: pre-wrap;
}

.ai-bubble {
  background: #fff;
  color: #333;
  border-top-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.07);
}

.user-bubble {
  background: var(--grad-brand);
  color: #fff;
  border-top-right-radius: 8rpx;
  box-shadow: 0 4rpx 14rpx rgba(46, 125, 50, 0.22);
}

/* 用户消息附带的照片缩略图：点击看大图 */
.user-photo {
  margin: 0 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 14rpx rgba(46, 125, 50, 0.18);
  flex-shrink: 0;
}

.user-photo-img {
  width: 200rpx;
  height: 200rpx;
  display: block;
}

/* AI消息旁的语音播放按钮：热区由 .tap-88 撑起 */
.voice-play-btn {
  margin-left: 12rpx;
  width: var(--tap-min);
  height: var(--tap-min);
  border-radius: 50%;
  background: var(--grad-brand);
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 喇叭图形：纯装饰，尺寸登记在 scripts/wxss-token-whitelist.json */
.vp-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
}

.vp-speaker {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-top: 12rpx solid transparent;
  border-bottom-color: #fff;
  border-top-color: #fff;
  position: relative;
  margin-left: 2rpx;
}

.vp-speaker::before {
  content: '';
  position: absolute;
  left: -6rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 8rpx;
  background: #fff;
  border-radius: 1rpx;
}

.vp-wave {
  position: absolute;
  border: 2rpx solid #fff;
  border-radius: 50%;
  border-left-color: transparent;
  border-bottom-color: transparent;
  border-top-color: transparent;
}

.vp-wave-1 {
  left: 14rpx;
  width: 8rpx;
  height: 8rpx;
}

.vp-wave-2 {
  left: 14rpx;
  width: 16rpx;
  height: 16rpx;
}

.vp-wave-3 {
  left: 14rpx;
  width: 24rpx;
  height: 24rpx;
}

/* —— 追问（多卡片全部答完才提交） —— */
.qa-block {
  display: flex;
  flex-direction: column;
  gap: var(--space-block);
}

.qa-progress {
  color: var(--text-brand);
  font-weight: 600;
}

.qa-item {
  margin-top: 0;
}

/* 已作答的卡片：整卡弱化并给品牌色描边，明确“这题已完成，等其余题” */
.qa-item.picked {
  border: 2rpx solid #43a047;
  background: #f6fbf5;
}

.qa-text {
  font-weight: 600;
  color: var(--text-primary);
}

.qa-why {
  margin-top: 8rpx;
}

.qa-options {
  display: flex;
  flex-direction: column;
  gap: var(--space-inline);
  margin-top: var(--space-heading);
}

.qa-option {
  width: 100%;
  border: 2rpx solid #c8e6c9;
  border-radius: 16rpx;
  background: #f6fbf5;
  color: var(--text-brand);
  font-size: var(--font-body);
  font-weight: 600;
  transition: background 0.15s ease, transform 0.15s ease;
}

.qa-option:active {
  background: #e3f2e4;
  transform: scale(0.98);
}

/* 选中的选项：实心品牌色，与未选项拉开对比 */
.qa-option.selected {
  background: var(--grad-brand);
  border-color: #2e7d32;
  color: var(--text-inverse);
}

.qa-unknown {
  border-color: #e0e0e0;
  background: #fafafa;
  color: var(--text-muted);
}

.qa-unknown.selected {
  background: var(--text-muted);
  border-color: var(--text-muted);
  color: var(--text-inverse);
}

/* 卡片内自由文本作答：选项不全或只有"说不清"时，农户可直接打字 */
.qa-input-row {
  display: flex;
  align-items: center;
  gap: var(--space-inline);
  margin-top: var(--space-inline);
}

.qa-input-box {
  flex: 1;
  background: #fff;
  border: 2rpx solid #c8e6c9;
  border-radius: 16rpx;
  padding: 0 24rpx;
  min-height: var(--tap-min);
  display: flex;
  align-items: center;
}

.qa-input {
  width: 100%;
  color: var(--text-primary);
  font-size: var(--font-body);
}

.qa-input-send {
  flex-shrink: 0;
  padding: 0 32rpx;
  min-height: var(--tap-min);
  border-radius: 16rpx;
  background: #cfd6cb;
  color: var(--text-inverse);
  font-size: var(--font-body);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s, box-shadow 0.2s;
}

.qa-input-send.active {
  background: var(--grad-brand);
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.3);
}

/* —— 处方卡：品牌绿左侧强调条 —— */
.rx-card {
  border-left: 8rpx solid #43a047;
}

.rx-summary {
  margin-bottom: var(--space-heading);
}

.rx-section {
  margin-top: var(--space-block);
}

.rx-section-title {
  margin-bottom: var(--space-heading);
}

.rx-action {
  margin-bottom: var(--space-inline);
}

.rx-action-main {
  color: var(--text-primary);
  font-weight: 600;
}

.rx-action-meta {
  margin-top: 6rpx;
}

.rx-pesticide {
  margin-bottom: var(--space-inline);
}

.rx-pesticide-name {
  font-weight: 600;
  color: var(--text-primary);
}

.rx-tech {
  margin-top: var(--space-heading);
  color: #b07d2b;
}

/* —— 存入台账按钮 —— */
.rx-ledger-btn {
  margin-top: var(--space-block);
  height: var(--btn-primary-height);
  border-radius: 16rpx;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-inverse);
  background: var(--grad-brand);
  box-shadow: var(--shadow-btn);
  display: flex;
  align-items: center;
  justify-content: center;
}

.rx-ledger-btn:active {
  opacity: 0.9;
}

.rx-ledger-btn.saved {
  color: var(--text-brand);
  background: #e8f5e9;
  box-shadow: none;
}

/* —— 转人工卡：琥珀色左侧强调条，与处方卡区分 —— */
.handoff-card {
  border-left: 8rpx solid #f0a53c;
}

.handoff-points {
  margin-top: var(--space-heading);
}

.handoff-contact {
  margin-top: var(--space-inline);
}

/* 输入栏：悬浮胶囊。语音为唯一常驻实心品牌色（主入口），拍照浅绿底（次入口），发送键随输入点亮 */
.input-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #fff;
  border-radius: 48rpx;
  box-shadow: 0 10rpx 36rpx rgba(46, 125, 50, 0.16);
  box-sizing: border-box;
  z-index: 99;
}

/* 三个圆形按钮：视觉 72rpx，热区由外层 .tap-88 撑满 88rpx（尺寸登记白名单） */
.voice-btn .voice-icon,
.photo-btn .photo-icon,
.send-btn .send-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease, background 0.2s, box-shadow 0.2s;
}

.voice-btn .voice-icon {
  background: var(--grad-brand);
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.25);
}

.voice-btn .voice-icon.recording {
  background: linear-gradient(135deg, #e53935, #c62828);
  animation: recording-pulse 1s ease-in-out infinite;
}

/* 录音态脉冲：给农户明确的“正在听”反馈 */
@keyframes recording-pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.08); opacity: 0.85; }
}

.photo-btn .photo-icon {
  background: #e8f4e9;
}

.voice-btn:active .voice-icon,
.photo-btn:active .photo-icon,
.send-btn:active .send-icon {
  transform: scale(0.92);
}

/* 麦克风图形：纯装饰，尺寸登记在 scripts/wxss-token-whitelist.json */
.voice-glyph {
  position: relative;
  width: 42rpx;
  height: 58rpx;
}

.voice-glyph::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
  width: 22rpx;
  height: 34rpx;
  border-radius: 11rpx;
  background: #fff;
}

.voice-glyph-arc {
  position: absolute;
  left: 50%;
  top: 18rpx;
  transform: translateX(-50%);
  width: 34rpx;
  height: 26rpx;
  border: 5rpx solid #fff;
  border-top: none;
  border-radius: 0 0 34rpx 34rpx;
  box-sizing: border-box;
}

.voice-glyph::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 44rpx;
  transform: translateX(-50%);
  width: 5rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: #fff;
}

/* 相机图形：纯装饰，尺寸登记在 scripts/wxss-token-whitelist.json */
.photo-glyph {
  position: relative;
  margin-top: 4rpx;
  width: 40rpx;
  height: 32rpx;
  border-radius: 8rpx;
  background: var(--text-brand);
}

.photo-glyph::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e8f4e9;
}

.photo-glyph::after {
  content: '';
  position: absolute;
  left: 5rpx;
  top: -7rpx;
  width: 16rpx;
  height: 8rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: var(--text-brand);
}

.input-wrap {
  flex: 1;
  background: #f0f6ee;
  border: 1rpx solid #e0ead9;
  border-radius: 44rpx;
  padding: 0 32rpx;
  min-height: var(--tap-min);
  display: flex;
  align-items: center;
}

.msg-input {
  width: 100%;
  color: #333;
}

.msg-input-ph {
  color: #93a98d;
}

.send-btn .send-icon {
  background: #c7d4c1;
}

.send-btn .send-icon.active {
  background: var(--grad-brand);
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.3);
}

/* 发送箭头图形：纯装饰，尺寸登记在 scripts/wxss-token-whitelist.json */
.send-glyph {
  position: relative;
  margin-top: 8rpx;
  width: 7rpx;
  height: 26rpx;
  border-radius: 3rpx;
  background: #fff;
}

.send-glyph::before {
  content: '';
  position: absolute;
  left: 50%;
  top: -3rpx;
  transform: translateX(-50%) rotate(45deg);
  width: 18rpx;
  height: 18rpx;
  border-left: 7rpx solid #fff;
  border-top: 7rpx solid #fff;
  border-radius: 5rpx 0 0 0;
}

/* —— 等待浮层：替代原生 wx.showLoading 灰盒 —— */
.thinking-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(23, 43, 24, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: thinking-fade-in 0.25s ease-out;
}

.thinking-card {
  width: 460rpx;
  background: var(--bg-card);
  border-radius: 36rpx;
  padding: 56rpx 48rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(20, 45, 22, 0.22);
  animation: thinking-pop 0.3s cubic-bezier(0.34, 1.4, 0.64, 1);
}

/* 小禾 + 双层呼吸光环 */
.thinking-stage {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thinking-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 168rpx;
  height: 168rpx;
  margin-left: -84rpx;
  margin-top: -84rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(67, 160, 71, 0.55);
  animation: thinking-ripple 2.2s ease-out infinite;
}

.thinking-ring.delay {
  animation-delay: 1.1s;
}

.thinking-mascot {
  animation: thinking-bob 1.8s ease-in-out infinite;
}

.thinking-hint {
  margin-top: 32rpx;
  font-size: var(--font-body);
  line-height: var(--line-body);
  color: var(--text-body);
  font-weight: 600;
  letter-spacing: 1rpx;
  text-align: center;
}

/* 三点节拍灯 */
.thinking-dots {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.tdot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--grad-brand);
  animation: thinking-dot 1.2s ease-in-out infinite;
}

.tdot:nth-child(2) {
  animation-delay: 0.2s;
}

.tdot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes thinking-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes thinking-pop {
  from { opacity: 0; transform: scale(0.86) translateY(16rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes thinking-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14rpx); }
}

@keyframes thinking-ripple {
  0% { transform: scale(0.72); opacity: 0.9; }
  100% { transform: scale(1.35); opacity: 0; }
}

@keyframes thinking-dot {
  0%, 100% { transform: translateY(0); opacity: 0.45; }
  50% { transform: translateY(-10rpx); opacity: 1; }
}
