@import '../../styles/tokens.wxss';
/* pages/ai/chat.wxss */
page {
  background: #ffffff;
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #ffffff;
}

/* 头部 */
.header {
  position: relative;
  background: linear-gradient(150deg, #43a047 0%, #2e7d32 55%, #1f5c24 100%);
  padding-top: calc(110rpx + env(safe-area-inset-top));
  padding-bottom: 32rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  min-height: calc(230rpx + env(safe-area-inset-top));
  box-sizing: border-box;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 0 0 36rpx 36rpx;
}

.header-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.deco-1 {
  width: 200rpx;
  height: 200rpx;
  right: -40rpx;
  top: -60rpx;
}

.deco-2 {
  width: 100rpx;
  height: 100rpx;
  right: 120rpx;
  bottom: -30rpx;
  background: rgba(255, 255, 255, 0.06);
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.header-title {
  font-size: var(--font-title);
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  line-height: var(--line-tight);
}

.header-sub {
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.85);
  line-height: var(--line-tight);
}

/* —— 作物标签条 —— */
.crop-tag-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.crop-tag-left {
  display: flex;
  align-items: center;
}

.crop-tag-label {
  color: #595959;
  margin-right: 16rpx;
}

.crop-tag-current {
  font-weight: 600;
  color: #2e7d32;
  background: #e8f5e9;
  padding: 6rpx 24rpx;
  border-radius: 24rpx;
}

.crop-tag-switch {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.switch-text {
  color: #2e7d32;
}

.switch-arrow {
  font-size: var(--font-body);
  color: #2e7d32;
  font-weight: 300;
  line-height: var(--line-tight);
}

/* 消息列表 */
.chat-scroll {
  flex: 1;
  width: 100%;
  height: calc(100vh - 310rpx - env(safe-area-inset-top));
  background: #f0f4ea;
  padding: 24rpx 24rpx calc(260rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.chat-list {
  padding-bottom: 24rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
}

.msg-row.ai-row {
  flex-direction: row;
}

.msg-row.user-row {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-avatar {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  border: 2rpx solid rgba(67, 160, 71, 0.15);
  overflow: hidden;
}

.msg-content {
  display: flex;
  align-items: flex-end;
  max-width: 75%;
  margin: 0 16rpx;
}

.ai-content {
  flex-direction: row;
  align-items: flex-end;
}

.user-content {
  flex-direction: row-reverse;
}

.msg-bubble {
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  word-break: break-all;
  white-space: pre-wrap;
}

.ai-bubble {
  background: #fff;
  color: #333;
  border-top-left-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.user-bubble {
  background: linear-gradient(135deg, #43a047, #2e7d32);
  color: #fff;
  border-top-right-radius: 8rpx;
}

/* AI消息旁的语音播放按钮：热区由 .tap-88 撑起 */
.voice-play-btn {
  margin-left: 12rpx;
  width: var(--tap-min);
  height: var(--tap-min);
  border-radius: 50%;
  background: linear-gradient(135deg, #43a047, #2e7d32);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 喇叭图形：纯装饰，尺寸登记在 scripts/wxss-token-whitelist.json */
.vp-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
}

.vp-speaker {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-top: 12rpx solid transparent;
  border-bottom-color: #fff;
  border-top-color: #fff;
  position: relative;
  margin-left: 2rpx;
}

.vp-speaker::before {
  content: '';
  position: absolute;
  left: -6rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 8rpx;
  background: #fff;
  border-radius: 1rpx;
}

.vp-wave {
  position: absolute;
  border: 2rpx solid #fff;
  border-radius: 50%;
  border-left-color: transparent;
  border-bottom-color: transparent;
  border-top-color: transparent;
}

.vp-wave-1 {
  left: 14rpx;
  width: 8rpx;
  height: 8rpx;
}

.vp-wave-2 {
  left: 14rpx;
  width: 16rpx;
  height: 16rpx;
}

.vp-wave-3 {
  left: 14rpx;
  width: 24rpx;
  height: 24rpx;
}

/* —— 追问（一次一步） —— */
.qa-block {
  display: flex;
  flex-direction: column;
  gap: var(--space-block);
}

.qa-item {
  margin-top: 0;
}

.qa-text {
  font-weight: 600;
  color: var(--text-primary);
}

.qa-why {
  margin-top: 8rpx;
}

.qa-options {
  display: flex;
  flex-direction: column;
  gap: var(--space-inline);
  margin-top: var(--space-heading);
}

.qa-option {
  width: 100%;
  border: 2rpx solid #c8e6c9;
  border-radius: 16rpx;
  background: #f6fbf5;
  color: var(--text-brand);
  font-size: var(--font-body);
  font-weight: 600;
}

.qa-unknown {
  border-color: #e0e0e0;
  background: #fafafa;
  color: var(--text-muted);
}

/* —— 处方卡 —— */
.rx-summary {
  margin-bottom: var(--space-heading);
}

.rx-section {
  margin-top: var(--space-block);
}

.rx-section-title {
  margin-bottom: var(--space-heading);
}

.rx-action {
  margin-bottom: var(--space-inline);
}

.rx-action-main {
  color: var(--text-primary);
  font-weight: 600;
}

.rx-action-meta {
  margin-top: 6rpx;
}

.rx-pesticide {
  margin-bottom: var(--space-inline);
}

.rx-pesticide-name {
  font-weight: 600;
  color: var(--text-primary);
}

.rx-tech {
  margin-top: var(--space-heading);
  color: #b07d2b;
}

/* —— 转人工卡 —— */
.handoff-points {
  margin-top: var(--space-heading);
}

.handoff-contact {
  margin-top: var(--space-inline);
}

/* 输入栏 */
.input-bar {
  position: fixed;
  left: 0;
  bottom: calc(110rpx + env(safe-area-inset-bottom));
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #e0e0e0;
  box-sizing: border-box;
  z-index: 99;
}

.voice-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.voice-btn .voice-icon {
  width: var(--tap-min);
  height: var(--tap-min);
  border-radius: 50%;
  background: linear-gradient(135deg, #43a047, #2e7d32);
  font-size: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-btn .voice-icon.recording {
  background: linear-gradient(135deg, #e53935, #c62828);
}

.voice-btn .voice-icon::before {
  content: "讲";
  font-size: var(--font-caption);
  color: #fff;
  font-weight: 500;
}

.voice-label {
  color: #595959;
}

.input-wrap {
  flex: 1;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 32rpx;
  min-height: var(--tap-min);
  display: flex;
  align-items: center;
}

.msg-input {
  width: 100%;
  color: #333;
}

.send-btn {
  width: var(--tap-min);
  height: var(--tap-min);
  border-radius: 50%;
  background: #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
  flex-shrink: 0;
}

.send-btn.active {
  background: linear-gradient(135deg, #43a047, #2e7d32);
}

.send-icon {
  color: #fff;
  font-size: var(--font-title);
  transform: rotate(-30deg);
}
