@import '../../styles/tokens.wxss';
/*login.wxss*/
page {
  height: 100vh;
  background: linear-gradient(180deg, #e8f5e9 0%, #f0f4ea 45%, #ffffff 100%);
  --page-padding: 48rpx;
  --max-content: 680rpx;
}

.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  min-height: 100vh;
  padding: 80rpx var(--page-padding) 0;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  width: 100%;
}

/* —— Logo 区域 —— */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 140rpx;
  width: 100%;
  max-width: var(--max-content);
}

.logo-card {
  width: 300rpx;
  height: 300rpx;
  background: #ffffff;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(46, 125, 50, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  overflow: hidden;
  flex-shrink: 0;
}

.app-name {
  font-size: var(--font-display);
  font-weight: bold;
  color: #2e4632;
  margin-top: 48rpx;
  letter-spacing: 6rpx;
  line-height: var(--line-tight);
}

.app-slogan {
  font-size: var(--font-body);
  color: #6b7a63;
  margin-top: 16rpx;
  letter-spacing: 2rpx;
  line-height: var(--line-body);
}

/* —— 登录区域 —— */
.login-section {
  width: 100%;
  max-width: var(--max-content);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin-bottom: 0;
}

.login-btn {
  width: 100%;
  height: 104rpx;
  background: linear-gradient(135deg, #43a047 0%, #2e7d32 100%);
  color: #ffffff;
  font-size: var(--font-body);
  font-weight: 500;
  border-radius: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  box-shadow: 0 12rpx 28rpx rgba(46, 125, 50, 0.25);
}

.login-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.login-btn.btn-loading {
  opacity: 0.7;
}

.agreement-wrapper {
  display: flex;
  align-items: flex-start;
  margin-top: 36rpx;
  width: 100%;
  box-sizing: border-box;
  justify-content: center;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #b0b8ad;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  flex-shrink: 0;
  transition: all 0.2s;
}

/* 复选框外层热区：88rpx，靠 .tap-88 撑起（app.wxss） */
.agreement-wrapper .tap-88 {
  align-self: flex-start;
}

.checkbox.checked {
  background: #2e7d32;
  border-color: #2e7d32;
}

.check-icon {
  color: #ffffff;
  font-size: var(--font-caption);
  font-weight: bold;
}

.agreement-text {
  font-size: var(--font-caption);
  color: #6b7a63;
  line-height: var(--line-body);
}

.link {
  color: #2e7d32;
}
