@import '../../styles/tokens.wxss';
/*login.wxss*/
page {
  height: 100vh;
  background: linear-gradient(180deg, #e8f5e9 0%, #eef5ec 45%, #ffffff 100%);
  --page-padding: 48rpx;
  --max-content: 680rpx;
}

.login-container {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  min-height: 100vh;
  padding: 80rpx var(--page-padding) 0;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
}

/* 背景装饰圆：柔和绿意层次，尺寸均不低于 88rpx */
.login-container::before {
  content: '';
  position: absolute;
  top: -120rpx;
  right: -140rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(67, 160, 71, 0.14), rgba(67, 160, 71, 0));
}

.login-container::after {
  content: '';
  position: absolute;
  bottom: 220rpx;
  left: -160rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(67, 160, 71, 0.1), rgba(67, 160, 71, 0));
}

/* —— Logo 区域 —— */
.logo-area {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 140rpx;
  width: 100%;
  max-width: var(--max-content);
}

.logo-card {
  position: relative;
  z-index: 1;
  width: 300rpx;
  height: 300rpx;
  background: #ffffff;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 56rpx rgba(46, 125, 50, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  overflow: hidden;
  flex-shrink: 0;
}

.app-name {
  font-size: var(--font-display);
  font-weight: bold;
  color: #2e4632;
  margin-top: 48rpx;
  letter-spacing: 6rpx;
  line-height: var(--line-tight);
}

.app-slogan {
  font-size: var(--font-body);
  color: #6b7a63;
  margin-top: 16rpx;
  letter-spacing: 2rpx;
  line-height: var(--line-body);
}

/* —— 登录区域 —— */
.login-section {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: var(--max-content);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin-bottom: 0;
}

.login-btn {
  width: 100%;
  height: 104rpx;
  background: var(--grad-brand);
  color: #ffffff;
  font-size: var(--font-body);
  font-weight: 500;
  border-radius: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  box-shadow: var(--shadow-btn);
  letter-spacing: 2rpx;
}

.login-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.login-btn.btn-loading {
  opacity: 0.7;
}

.agreement-wrapper {
  display: flex;
  align-items: flex-start;
  margin-top: 36rpx;
  width: 100%;
  box-sizing: border-box;
  justify-content: center;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #b0b8ad;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  flex-shrink: 0;
  transition: all 0.2s;
}

/* 复选框外层热区：88rpx，靠 .tap-88 撑起（app.wxss） */
.agreement-wrapper .tap-88 {
  align-self: flex-start;
}

.checkbox.checked {
  background: var(--grad-brand);
  border-color: #2e7d32;
  box-shadow: 0 2rpx 8rpx rgba(46, 125, 50, 0.3);
}

.check-icon {
  color: #ffffff;
  font-size: var(--font-caption);
  font-weight: bold;
}

.agreement-text {
  font-size: var(--font-caption);
  color: #6b7a63;
  line-height: var(--line-body);
}

.link {
  color: #2e7d32;
}
