/*login.wxss*/
page {
  height: 100vh;
  background: #eef5ec;
  --page-padding: 48rpx;
  --max-content: 680rpx;
}

.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  min-height: 100vh;
  padding: 80rpx var(--page-padding) 0;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  width: 100%;
}

/* —— Logo 区域 —— */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 180rpx;
  width: 100%;
  max-width: var(--max-content);
}

.logo-card {
  width: 260rpx;
  height: 260rpx;
  background: #ffffff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  flex-shrink: 0;
}

.logo-image {
  width: 220rpx;
  height: 220rpx;
}

.app-name {
  font-size: 52rpx;
  font-weight: bold;
  color: #2e7d32;
  margin-top: 48rpx;
  letter-spacing: 4rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #666;
  margin-top: 16rpx;
}

/* —— 登录区域 —— */
.login-section {
  width: 100%;
  max-width: var(--max-content);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin-bottom: 0;
}

.login-btn {
  width: 100%;
  height: 100rpx;
  background: #2e7d32;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 500;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
}

.login-btn:active {
  background: #256427;
  opacity: 0.9;
}

.agreement-wrapper {
  display: flex;
  align-items: flex-start;
  margin-top: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #aaa;
  border-radius: 6rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.checkbox.checked {
  background: #2e7d32;
  border-color: #2e7d32;
}

.check-icon {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
}

.agreement-text {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
}

.link {
  color: #2e7d32;
}
