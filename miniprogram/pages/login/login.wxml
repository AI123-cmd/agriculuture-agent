<!--login.wxml-->
<view class="login-container">
  <view class="logo-area">
    <view class="logo-card">
      <image class="logo-image" src="/images/logo.jpg" mode="aspectFit"></image>
    </view>
    <view class="app-name">话农点金</view>
    <view class="app-slogan">种地有难题，找话农点金</view>
  </view>

  <view class="login-section">
    <view class="login-btn" bindtap="onWxLogin">微信用户一键登录</view>

    <view class="agreement-wrapper">
      <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="toggleAgree">
        <text wx:if="{{agreed}}" class="check-icon">✓</text>
      </view>
      <view class="agreement-text">
        登录即代表同意
        <text class="link" bindtap="openUserAgreement">《用户协议》</text>
        和
        <text class="link" bindtap="openPrivacyPolicy">《隐私政策》</text>
      </view>
    </view>
  </view>
</view>
