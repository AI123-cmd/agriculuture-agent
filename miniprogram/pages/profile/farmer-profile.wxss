@import '../../styles/tokens.wxss';
.page {
  min-height: 100vh;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
}

/* 顶部标题区 */
.header {
  position: relative;
  background: var(--grad-header);
  color: #fff;
  padding: calc(80rpx + env(safe-area-inset-top)) 48rpx 40rpx;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.18);
  overflow: hidden;
}

/* 头部装饰圆：纯装饰图形 */
.header-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.deco-1 {
  width: 220rpx;
  height: 220rpx;
  right: -60rpx;
  top: -80rpx;
}

.deco-2 {
  width: 120rpx;
  height: 120rpx;
  right: 130rpx;
  bottom: -50rpx;
  background: rgba(255, 255, 255, 0.06);
}

.back-btn,
.header-title,
.header-sub {
  position: relative;
  z-index: 1;
}

.back-btn {
  color: #fff;
  font-size: var(--font-display);
  line-height: var(--line-tight);
  margin-bottom: 16rpx;
  width: var(--tap-min);
  height: var(--tap-min);
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-title {
  font-size: var(--font-heading);
  font-weight: 700;
  line-height: var(--line-tight);
  margin-bottom: 12rpx;
}

.header-sub {
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.85);
  line-height: var(--line-body);
}

/* 滚动内容区 */
.scroll-area {
  flex: 1;
  padding: 0 30rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 模块间距与卡片由 app.wxss 公共类 .block / .card / .card-title 提供 */

.card-hint {
  font-size: var(--font-caption);
  font-weight: 400;
  color: #595959;
  margin-left: 12rpx;
}

/* 作物输入行 */
.crop-input-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.crop-input {
  flex: 1;
}

.add-btn {
  flex-shrink: 0;
  min-height: var(--btn-primary-height);
  padding: 0 36rpx;
  border-radius: 16rpx;
  background: var(--grad-brand);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 600;
  line-height: var(--btn-primary-height);
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.22);
}

.add-btn:active {
  opacity: 0.88;
}

/* 快捷选择 */
.quick-crops {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.quick-crops-label {
  font-size: var(--font-caption);
  color: #595959;
  line-height: var(--line-body);
}

.quick-crop-tag {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #eef5ec;
  border: 1rpx solid #dce8d8;
  color: var(--text-brand);
  font-size: var(--font-body);
  line-height: var(--line-body);
  min-height: var(--tap-min);
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.quick-crop-tag:active {
  background: #dff0dc;
}

/* 已添加作物列表 */
.selected-crop-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.selected-crop-item {
  padding: 24rpx;
  background: #f4f8f1;
  border-radius: 16rpx;
  border-left: 8rpx solid #43a047;
  box-shadow: 0 2rpx 10rpx rgba(46, 125, 50, 0.05);
}

.selected-crop-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.selected-crop-name {
  font-size: var(--font-title);
  font-weight: 600;
  color: #2e7d32;
  line-height: var(--line-tight);
}

.selected-crop-remove {
  color: #e53935;
  min-height: var(--tap-min);
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.selected-crop-body {
  display: flex;
  gap: 20rpx;
}

.crop-field {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.crop-field-label {
  font-size: var(--font-caption);
  color: #595959;
  line-height: var(--line-body);
}

.crop-field-input {
  height: var(--tap-min);
  background: #fff;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: var(--font-body);
  color: #2c2c2c;
  line-height: var(--tap-min);
}

.crop-field-picker {
  height: var(--tap-min);
  background: #fff;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: var(--font-body);
  color: #2c2c2c;
  line-height: var(--tap-min);
}

.crop-field-picker.placeholder {
  color: #b0b0b0;
}

/* 表单项 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: var(--font-body);
  color: #2c2c2c;
  line-height: var(--line-body);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #e53935;
  margin-right: 6rpx;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  height: var(--tap-min);
  background: #ffffff;
  border: 1rpx solid #e2eadd;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: var(--font-body);
  color: #2c2c2c;
  line-height: var(--line-body);
}

.form-input::placeholder {
  color: #b0b0b0;
}

.form-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  background: #ffffff;
  border: 1rpx solid #e2eadd;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: var(--font-body);
  color: #2c2c2c;
  line-height: var(--line-body);
}

.form-textarea::placeholder {
  color: #b0b0b0;
}

.count-hint {
  text-align: right;
  font-size: var(--font-caption);
  color: #595959;
  line-height: var(--line-body);
  margin-top: 8rpx;
}

/* 选择器样式 */
.form-picker {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  background: #ffffff;
  border: 1rpx solid #e2eadd;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: var(--font-body);
  color: #2c2c2c;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-picker.placeholder {
  color: #b0b0b0;
}

.picker-arrow {
  color: #b0b0b0;
  font-size: var(--font-title);
  line-height: var(--line-tight);
  transform: rotate(90deg);
}

/* 单选按钮组 两列 */
.radio-group {
  display: flex;
  gap: 20rpx;
}

.radio-group.three .radio-item {
  flex: 1;
}

.radio-item {
  flex: 1;
  height: var(--tap-min);
  border-radius: 16rpx;
  background: #ffffff;
  border: 2rpx solid #e2eadd;
  color: #595959;
  font-size: var(--font-body);
  line-height: var(--tap-min);
  text-align: center;
  transition: all 0.2s;
}

.radio-item.active {
  background: var(--grad-brand);
  border-color: transparent;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.25);
}

/* 底部提交按钮区 */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 24rpx rgba(46, 125, 50, 0.08);
}

.submit-btn {
  height: 100rpx;
  border-radius: 50rpx;
  background: var(--grad-brand);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 100rpx;
  text-align: center;
  width: 100%;
  letter-spacing: 2rpx;
  box-shadow: var(--shadow-btn);
}

.submit-btn:active {
  transform: scale(0.98);
  opacity: 0.95;
}

.submit-btn[disabled],
.submit-btn.disabled {
  background: #a5c4a7;
}

/* 底部占位 */
.footer-placeholder {
  height: 40rpx;
}
