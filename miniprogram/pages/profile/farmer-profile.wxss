@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
}

/* ========== 顶部标题区 ========== */
.header {
  position: relative;
  background: var(--grad-header);
  color: #fff;
  padding: calc(80rpx + env(safe-area-inset-top)) 48rpx 44rpx;
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.18);
  overflow: hidden;
}

/* 头部装饰圆：纯装饰图形 */
.header-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.deco-1 {
  width: 260rpx;
  height: 260rpx;
  right: -70rpx;
  top: -90rpx;
}

.deco-2 {
  width: 140rpx;
  height: 140rpx;
  right: 150rpx;
  bottom: -60rpx;
  background: rgba(255, 255, 255, 0.06);
}

.back-btn,
.header-title,
.header-sub {
  position: relative;
  z-index: 1;
}

.back-btn {
  width: var(--tap-min);
  height: var(--tap-min);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -16rpx;
  margin-bottom: 12rpx;
}

.back-btn:active {
  opacity: 0.6;
}

/* 纯 CSS 返回箭头 */
.back-arrow {
  width: 22rpx;
  height: 22rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  border-radius: 3rpx;
  transform: rotate(45deg);
}

.header-title {
  font-size: var(--font-heading);
  font-weight: 700;
  line-height: var(--line-tight);
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.header-sub {
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.85);
  line-height: var(--line-body);
}

/* ========== 滚动内容区 ========== */
.scroll-area {
  flex: 1;
  padding: 0 30rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 卡片依次浮现 */
.scroll-area .card {
  animation: card-in 0.5s ease both;
}

.scroll-area .card:nth-child(2) {
  animation-delay: 0.08s;
}

.scroll-area .card:nth-child(3) {
  animation-delay: 0.16s;
}

.scroll-area .card:nth-child(4) {
  animation-delay: 0.24s;
}

@keyframes card-in {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ========== 分组标题：图标 + 文字 ========== */
.sec-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.sec-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #eef5ec;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-title);
  line-height: var(--line-tight);
  flex-shrink: 0;
}

.sec-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-primary);
  line-height: var(--line-tight);
}

.sec-desc {
  font-size: var(--font-caption);
  color: #8a9a8a;
  line-height: var(--line-body);
  margin-top: -20rpx;
  margin-bottom: 32rpx;
  padding-left: 80rpx;
}

/* ========== 表单项 ========== */
.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 8rpx;
}

.form-label {
  font-size: var(--font-body);
  color: var(--text-primary);
  line-height: var(--line-body);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #e53935;
  margin-right: 6rpx;
}

/* 选填角标 */
.optional {
  font-size: var(--font-caption);
  color: #a5b5a5;
  font-weight: 400;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  background: #f2f6f0;
  border-radius: 8rpx;
}

/* 输入框：浅灰底无边框，聚焦感交给微信原生光标 */
.form-input {
  width: 100%;
  box-sizing: border-box;
  height: 96rpx;
  background: #f6f8f4;
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: var(--font-body);
  color: var(--text-primary);
  line-height: var(--line-body);
}

.form-input::placeholder {
  color: #b0b0b0;
}

.form-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  background: #f6f8f4;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: var(--font-body);
  color: var(--text-primary);
  line-height: var(--line-body);
}

.form-textarea::placeholder {
  color: #b0b0b0;
}

.count-hint {
  text-align: right;
  font-size: var(--font-caption);
  color: #8a9a8a;
  line-height: var(--line-body);
  margin-top: 8rpx;
}

/* 选择器：与输入框同款 */
.form-picker {
  width: 100%;
  box-sizing: border-box;
  height: 96rpx;
  background: #f6f8f4;
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: var(--font-body);
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-picker.placeholder {
  color: #b0b0b0;
}

.picker-arrow {
  color: #b0b0b0;
  font-size: var(--font-title);
  line-height: var(--line-tight);
  transform: rotate(90deg);
}

/* ========== 单选按钮组 ========== */
.radio-group {
  display: flex;
  gap: 20rpx;
}

.radio-group.three .radio-item {
  flex: 1;
}

.radio-item {
  flex: 1;
  height: 96rpx;
  border-radius: 20rpx;
  background: #f6f8f4;
  border: 2rpx solid transparent;
  color: #595959;
  font-size: var(--font-body);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.radio-item.active {
  background: var(--grad-brand);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(46, 125, 50, 0.28);
}

/* ========== 添加作物：虚线大按钮 ========== */
.add-crop-btn {
  height: 96rpx;
  border-radius: 20rpx;
  border: 2rpx dashed #7cb342;
  background: #f4f9f0;
  color: var(--text-brand);
  font-size: var(--font-body);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.add-crop-btn:active {
  background: #e8f2e2;
}

.add-plus {
  font-weight: 400;
}

/* ========== 快捷选择 ========== */
.quick-crops {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

.quick-crops-label {
  font-size: var(--font-caption);
  color: #8a9a8a;
  line-height: var(--line-body);
}

.quick-crop-tag {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #eef5ec;
  color: var(--text-brand);
  font-size: var(--font-body);
  line-height: var(--line-body);
  min-height: var(--tap-min);
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.quick-crop-tag:active {
  background: #dff0dc;
}

/* ========== 已添加作物列表 ========== */
.selected-crop-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #eef2ea;
}

.selected-crop-item {
  padding: 24rpx;
  background: #f6f8f4;
  border-radius: 20rpx;
}

.selected-crop-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.crop-name-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.crop-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--grad-brand);
  flex-shrink: 0;
}

.selected-crop-name {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-brand);
  line-height: var(--line-tight);
}

.selected-crop-remove {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(229, 57, 53, 0.08);
  color: #e53935;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-body);
}

.selected-crop-remove:active {
  background: rgba(229, 57, 53, 0.16);
}

.selected-crop-body {
  display: flex;
  gap: 20rpx;
}

/* 第二条字段行与“其他作物”名称行、阶段行之间留出间距 */
.selected-crop-body + .selected-crop-body,
.selected-crop-body + .crop-field,
.crop-field + .selected-crop-body,
.selected-crop-item .crop-field + .crop-field {
  margin-top: 20rpx;
}

.selected-crop-item .crop-field {
  margin-bottom: 0;
}

.crop-field {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.crop-field-label {
  font-size: var(--font-caption);
  color: #7a8a7a;
  line-height: var(--line-body);
}

.crop-field-input {
  height: 88rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: var(--font-body);
  color: var(--text-primary);
  line-height: var(--line-body);
}

.crop-field-picker {
  height: 88rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: var(--font-body);
  color: var(--text-primary);
  display: flex;
  align-items: center;
}

.crop-field-picker.placeholder {
  color: #b0b0b0;
}

/* ========== 底部提交按钮区 ========== */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.96);
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 24rpx rgba(46, 125, 50, 0.08);
}

.submit-btn {
  height: 104rpx;
  border-radius: 52rpx;
  background: var(--grad-brand);
  color: #fff;
  font-size: var(--font-title);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  letter-spacing: 4rpx;
  box-shadow: var(--shadow-btn);
  transition: transform 0.15s ease;
}

.submit-btn:active {
  transform: scale(0.97);
  opacity: 0.95;
}

/* 底部占位 */
.footer-placeholder {
  height: 40rpx;
}
