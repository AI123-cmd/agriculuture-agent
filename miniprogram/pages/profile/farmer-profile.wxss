.page {
  min-height: 100vh;
  background: #f0f4ea;
  display: flex;
  flex-direction: column;
}

/* 顶部标题区 */
.header {
  background: linear-gradient(150deg, #43a047 0%, #2e7d32 55%, #1f5c24 100%);
  color: #fff;
  padding: calc(80rpx + env(safe-area-inset-top)) 48rpx 40rpx;
}

.back-btn {
  color: #fff;
  font-size: 56rpx;
  line-height: 1;
  margin-bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.header-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.5;
}

/* 滚动内容区 */
.scroll-area {
  flex: 1;
  padding: 0 30rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 模块间距 */
.item-block {
  margin-top: 32rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.06);
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2e4632;
  line-height: 1.5;
  margin-bottom: 32rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #2e7d32;
}

.card-hint {
  font-size: 24rpx;
  font-weight: 400;
  color: #999;
  margin-left: 12rpx;
}

/* 作物输入行 */
.crop-input-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.crop-input {
  flex: 1;
}

.add-btn {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 36rpx;
  border-radius: 12rpx;
  background: #2e7d32;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

/* 快捷选择 */
.quick-crops {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.quick-crops-label {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.quick-crop-tag {
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
  background: #f8f9f8;
  color: #666;
  font-size: 26rpx;
  line-height: 1.5;
}

/* 已添加作物列表 */
.selected-crop-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.selected-crop-item {
  padding: 24rpx;
  background: #f8f9f8;
  border-radius: 16rpx;
  border-left: 6rpx solid #2e7d32;
}

.selected-crop-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.selected-crop-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2e7d32;
  line-height: 1.5;
}

.selected-crop-remove {
  font-size: 26rpx;
  color: #e53935;
  line-height: 1.5;
}

.selected-crop-body {
  display: flex;
  gap: 20rpx;
}

.crop-field {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.crop-field-label {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.crop-field-input {
  height: 72rpx;
  background: #fff;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #2c2c2c;
  line-height: 72rpx;
}

.crop-field-picker {
  height: 72rpx;
  background: #fff;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #2c2c2c;
  line-height: 72rpx;
}

.crop-field-picker.placeholder {
  color: #b0b0b0;
}

/* 表单项 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #2c2c2c;
  line-height: 1.5;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #e53935;
  margin-right: 6rpx;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  background: #f8f9f8;
  border-radius: 12rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #2c2c2c;
  line-height: 1.5;
}

.form-input::placeholder {
  color: #b0b0b0;
}

.form-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  background: #f8f9f8;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #2c2c2c;
  line-height: 1.5;
}

.form-textarea::placeholder {
  color: #b0b0b0;
}

.count-hint {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-top: 8rpx;
}

/* 选择器样式 */
.form-picker {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  background: #f8f9f8;
  border-radius: 12rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #2c2c2c;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-picker.placeholder {
  color: #b0b0b0;
}

.picker-arrow {
  color: #b0b0b0;
  font-size: 40rpx;
  line-height: 1;
  transform: rotate(90deg);
}

/* 单选按钮组 两列 */
.radio-group {
  display: flex;
  gap: 20rpx;
}

.radio-group.three .radio-item {
  flex: 1;
}

.radio-item {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  background: #f8f9f8;
  border: 2rpx solid transparent;
  color: #666;
  font-size: 28rpx;
  line-height: 88rpx;
  text-align: center;
  transition: all 0.2s;
}

.radio-item.active {
  background: rgba(46, 125, 50, 0.08);
  border-color: #2e7d32;
  color: #2e7d32;
  font-weight: 600;
}

/* 底部提交按钮区 */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  height: 100rpx;
  border-radius: 50rpx;
  background: linear-gradient(135deg, #43a047, #2e7d32);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 100rpx;
  text-align: center;
  width: 100%;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 20rpx rgba(46, 125, 50, 0.25);
}

.submit-btn[disabled],
.submit-btn.disabled {
  background: #a5c4a7;
}

/* 底部占位 */
.footer-placeholder {
  height: 40rpx;
}
