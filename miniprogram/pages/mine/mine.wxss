@import '../../styles/tokens.wxss';
/* pages/mine/mine.wxss */
page {
  background: #f0f4ea;
}

.mine-page {
  min-height: 100vh;
  background: #f0f4ea;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* —— 顶部用户区域 —— */
.header {
  position: relative;
  background: linear-gradient(155deg, #4caf50 0%, #2e7d32 55%, #1b5e20 100%);
  padding-top: calc(110rpx + env(safe-area-inset-top));
  padding-bottom: 44rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  min-height: calc(260rpx + env(safe-area-inset-top));
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 0 0 40rpx 40rpx;
}

.header-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.deco-1 {
  width: 260rpx;
  height: 260rpx;
  right: -70rpx;
  top: -90rpx;
}

.deco-2 {
  width: 130rpx;
  height: 130rpx;
  right: 150rpx;
  bottom: -55rpx;
  background: rgba(255, 255, 255, 0.06);
}

.deco-3 {
  width: 90rpx;
  height: 90rpx;
  left: -30rpx;
  bottom: 30rpx;
  background: rgba(255, 255, 255, 0.05);
}

.header-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-card {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  min-height: var(--tap-min);
}

/* 头像 + 编辑角标 */
.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #fff;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

.avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cam-body {
  width: 18rpx;
  height: 13rpx;
  background: #2e7d32;
  border-radius: 3rpx;
}

.cam-lens {
  position: absolute;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #fff;
}

.user-info {
  margin-left: 28rpx;
  min-width: 0;
}

.nickname {
  font-size: var(--font-title);
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
  line-height: var(--line-tight);
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}

.farmer-tag {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  font-size: var(--font-caption);
  color: #fff;
}

.tag-leaf {
  width: 12rpx;
  height: 16rpx;
  background: #fff;
  border-radius: 50% 0 50% 0;
  transform: rotate(45deg);
  margin-right: 8rpx;
}

.user-slogan {
  margin-top: 12rpx;
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
  line-height: var(--line-tight);
}

.mascot-wrap {
  flex-shrink: 0;
  margin-left: 16rpx;
  animation: mascot-float 3s ease-in-out infinite;
}

@keyframes mascot-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

/* —— 分组标题 —— */
.section-label {
  display: flex;
  align-items: center;
  margin: 32rpx 40rpx 16rpx;
  font-size: var(--font-caption);
  font-weight: 600;
  color: #7a8a72;
  letter-spacing: 2rpx;
}

.section-label::before {
  content: '';
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #66bb6a, #2e7d32);
  margin-right: 14rpx;
}

/* —— 菜单组 —— */
.menu-section {
  margin: 0 30rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(46, 125, 50, 0.08);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  position: relative;
  min-height: var(--tap-min);
  box-sizing: border-box;
  transition: background 0.15s ease;
}

.menu-item-hover {
  background: #f4f8f1;
}

/* 菜单图标公共（装饰图形，尺寸登记在白名单） */
.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 农户档案：人像图标 */
.mi-profile {
  background: linear-gradient(135deg, #66bb6a, #43a047);
}

.mi-person-head {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #fff;
}

.mi-person-body {
  width: 32rpx;
  height: 18rpx;
  margin-top: 4rpx;
  border-radius: 14rpx 14rpx 4rpx 4rpx;
  background: #fff;
}

/* 咨询历史：时钟图标 */
.mi-history {
  background: linear-gradient(135deg, #ffb74d, #fb8c00);
}

.mi-clock {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  box-sizing: border-box;
}

.mi-hand-h {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 4rpx;
  height: 10rpx;
  background: #fff;
  border-radius: 2rpx;
  transform: translate(-50%, -100%);
}

.mi-hand-m {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 9rpx;
  height: 4rpx;
  background: #fff;
  border-radius: 2rpx;
  transform: translateY(-50%);
}

/* 环境数据：水滴 + 叶图标 */
.mi-env {
  background: linear-gradient(135deg, #4dd0e1, #00897b);
}

.mi-env-drop {
  width: 18rpx;
  height: 24rpx;
  background: #fff;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.mi-env-leaf {
  width: 14rpx;
  height: 8rpx;
  margin-top: 3rpx;
  background: #fff;
  border-radius: 50% 0 50% 0;
}

/* 关于我们：信息图标 */
.mi-about {
  background: linear-gradient(135deg, #4fc3f7, #1e88e5);
}

.mi-info-dot {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #fff;
}

.mi-info-bar {
  width: 7rpx;
  height: 20rpx;
  margin-top: 5rpx;
  border-radius: 4rpx;
  background: #fff;
}

/* 用户协议：文档图标 */
.mi-doc {
  background: linear-gradient(135deg, #f06292, #e53935);
}

.mi-doc-paper {
  width: 28rpx;
  height: 34rpx;
  border: 3rpx solid #fff;
  border-radius: 5rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mi-doc-line {
  width: 14rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #fff;
  margin: 2rpx 0;
}

.mi-doc-line.short {
  width: 9rpx;
}

.menu-text {
  flex: 1;
  font-size: var(--font-body);
  font-weight: 500;
  color: #2b2b2b;
}

.menu-arrow {
  font-size: var(--font-body);
  color: #c5cbbf;
  font-weight: 300;
  line-height: var(--line-tight);
}

.menu-divider {
  height: 1rpx;
  background: #f2f4ef;
  margin-left: 128rpx;
}

/* —— 退出登录 —— */
.logout-section {
  margin: 48rpx 30rpx 0;
}

.logout-btn {
  min-height: var(--btn-primary-height);
  background: #fff;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-body);
  color: #e53935;
  font-weight: 600;
  letter-spacing: 4rpx;
  box-shadow: 0 6rpx 24rpx rgba(46, 125, 50, 0.08);
  transition: background 0.15s ease;
}

.logout-btn-hover {
  background: #fef2f2;
}

.cancel-account-btn {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--font-caption);
  color: #6b7a63;
  padding: 16rpx 0;
  min-height: var(--tap-min);
  box-sizing: border-box;
}

.cancel-account-btn:active {
  color: #e53935;
}

/* —— 页脚 —— */
.page-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 56rpx;
  font-size: var(--font-caption);
  color: #6b7a63;
  letter-spacing: 1rpx;
}

.footer-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #c9d4c0;
  margin: 0 18rpx;
}

/* —— 修改头像弹层 —— */
.profile-edit-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.profile-edit-sheet {
  width: 100%;
  max-width: 750rpx;
  max-height: calc(100vh - 20rpx);
  background: #f7f9f4;
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 30rpx calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.sheet-bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #d5dcd0;
  margin: 0 auto 24rpx;
}

.edit-title {
  text-align: center;
  font-size: var(--font-title);
  font-weight: 600;
  color: #1a1a1a;
  line-height: var(--line-tight);
  margin-bottom: 32rpx;
}

.avatar-preview-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 36rpx;
}

.avatar-preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.15);
  box-sizing: border-box;
}

.edit-row {
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(46, 125, 50, 0.05);
}

.edit-avatar-btn {
  background: linear-gradient(135deg, #43a047, #2e7d32);
  color: #fff;
  font-size: var(--font-body);
  border-radius: 14rpx;
  min-height: var(--btn-primary-height);
  line-height: var(--btn-primary-height);
  margin: 0;
}

.edit-avatar-btn::after {
  border: none;
}

.edit-submit-btn {
  background: linear-gradient(135deg, #43a047, #2e7d32);
  color: #fff;
  text-align: center;
  font-size: var(--font-body);
  font-weight: 600;
  letter-spacing: 2rpx;
  min-height: var(--btn-primary-height);
  line-height: var(--btn-primary-height);
  border-radius: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(46, 125, 50, 0.25);
}

.edit-submit-btn:active {
  opacity: 0.85;
}

.edit-cancel-btn {
  background: #fff;
  color: #666;
  text-align: center;
  font-size: var(--font-body);
  min-height: var(--btn-primary-height);
  line-height: var(--btn-primary-height);
  border-radius: 20rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(46, 125, 50, 0.05);
}

.edit-cancel-btn:active {
  background: #f0f0f0;
}
