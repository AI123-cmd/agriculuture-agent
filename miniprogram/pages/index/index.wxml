<!--index.wxml-->
<view class="page">
  <!-- 固定顶部用户栏 -->
  <view class="header">
    <view class="header-deco deco-1"></view>
    <view class="header-deco deco-2"></view>
    <view class="header-main">
      <view class="user-info">
        <image class="avatar" src="{{userAvatar}}" mode="aspectFill"></image>
        <view class="user-detail">
          <view class="crop-name">当前作物：{{currentCrop}}</view>
          <view class="farmer-name">农户：{{farmerName}}</view>
        </view>
      </view>
      <view class="mascot-wrap">
        <sprout-mascot size="{{96}}" />
      </view>
    </view>
  </view>

  <!-- 滚动内容区域，统一左右 padding，预留顶部头部和底部导航高度 -->
  <view class="page-content">
    <!-- 地点信息 -->
    <view class="location-row block" bindtap="chooseLocation">
      <view class="location-left">
        <view class="location-pin"></view>
        <text class="location-name">{{locationName}}</text>
      </view>
      <text class="location-set">设置 ›</text>
    </view>

    <!-- 环境一行状态：只读展示，不可点击 -->
    <view class="env-line block">
      <text class="env-line-text">{{envLine}}</text>
    </view>

    <!-- 今日提示 -->
    <view class="card block">
      <view class="card-header">
        <view class="card-title">今日提示</view>
        <view class="card-badge" wx:if="{{generatedLabel}}">{{generatedLabel}}</view>
      </view>

      <view class="tip-list" wx:if="{{tipItems.length > 0}}">
        <view class="tip-item {{item.executed ? 'tip-done' : ''}}" wx:for="{{tipItems}}" wx:key="itemId">
          <view class="tip-body">
            <view class="tip-callout">{{item.callout}}</view>
            <view class="tip-fact">{{item.fact}}</view>
            <view class="tip-impact">{{item.impact}}</view>
            <view class="tip-action">{{item.action}}</view>
          </view>
          <view class="tip-actions">
            <!-- 朗读触发位：容器与类名在此定义，行为由 T4-04 实现 -->
            <view class="tip-read-btn tap-88" data-id="{{item.itemId}}">
              <text class="tip-read-icon">读</text>
            </view>
            <!-- 执行勾选：仅当日快照可操作 -->
            <view
              class="tap-88"
              wx:if="{{isToday}}"
              bindtap="onToggleExecuted"
              data-id="{{item.itemId}}"
            >
              <view class="check-circle {{item.executed ? 'tip-check-done' : ''}}">
                <text class="check-icon">{{item.executed ? '✓' : ''}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="tip-empty" wx:else>今天暂时没有需要特别注意的农事，保持日常管理即可。</view>

      <view class="card-footer">
        <view class="btn-primary update-btn" bindtap="onUpdateTips">{{updating ? '更新中…' : '更新提示'}}</view>
      </view>
    </view>

    <!-- 核心动作：我要提问 -->
    <view class="btn-primary ask-btn" bindtap="onAsk">我要提问</view>
  </view>

</view>
