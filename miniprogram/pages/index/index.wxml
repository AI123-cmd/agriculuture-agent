<!--index.wxml-->
<view class="page">
  <!-- 沉浸式顶部区域：只放用户卡片，成为视觉焦点 -->
  <view class="hero-section">
    <view class="hero-bg"></view>
    <view class="hero-deco deco-1"></view>
    <view class="hero-deco deco-2"></view>

    <view class="hero-content">
      <view class="user-card">
        <view class="user-left">
          <image class="avatar" src="{{userAvatar}}" mode="aspectFill"></image>
          <view class="user-detail">
            <view class="user-crop">{{currentCrop}}</view>
            <view class="user-name">{{farmerName}}</view>
          </view>
        </view>
        <view class="mascot-wrap">
          <sprout-mascot size="{{88}}" />
        </view>
      </view>
    </view>
  </view>

  <!-- 主内容区 -->
  <view class="main-content">
    <!-- 状态卡：位置（可点击）+ 环境（只读），半浮在 hero 下沿衔接两个区域 -->
    <view class="status-card">
      <view class="status-row location-row" bindtap="chooseLocation">
        <view class="status-icon location-icon">
          <view class="pin"></view>
        </view>
        <view class="status-content">
          <view class="status-label">当前位置</view>
          <view class="status-value">{{locationName}}</view>
        </view>
        <view class="status-arrow">›</view>
      </view>

      <view class="status-divider"></view>

      <view class="status-row env-row">
        <view class="status-icon env-icon">
          <view class="env-dot"></view>
        </view>
        <view class="status-content">
          <view class="status-label">环境状态</view>
          <view class="status-value env-value">{{envLine}}</view>
        </view>
      </view>
    </view>

    <!-- 今日提示卡片 -->
    <view class="card tips-card block">
      <view class="card-header">
        <view class="card-title-wrap">
          <view class="card-title-icon">📋</view>
          <view class="card-title">今日提示</view>
        </view>
        <view class="card-badge" wx:if="{{generatedLabel}}">{{generatedLabel}}</view>
      </view>

      <view class="tip-list" wx:if="{{tipItems.length > 0}}">
        <view class="tip-item {{item.executed ? 'tip-done' : ''}}" wx:for="{{tipItems}}" wx:key="itemId">
          <view class="tip-body">
            <view class="tip-callout">{{item.callout}}</view>
            <view class="tip-fact">{{item.fact}}</view>
            <view class="tip-impact">{{item.impact}}</view>
            <view class="tip-action">{{item.action}}</view>
          </view>
          <view class="tip-actions">
            <view class="tip-read-btn tap-88" bindtap="onReadTip" data-id="{{item.itemId}}">
              <text class="tip-read-icon">读</text>
            </view>
            <view
              class="tap-88"
              wx:if="{{isToday}}"
              bindtap="onToggleExecuted"
              data-id="{{item.itemId}}"
            >
              <view class="check-circle {{item.executed ? 'tip-check-done' : ''}}">
                <text class="check-icon">{{item.executed ? '✓' : ''}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="tip-empty" wx:else>
        <view class="empty-icon">🌱</view>
        <view class="empty-text">今天暂时没有需要特别注意的农事</view>
        <view class="empty-sub">保持日常管理即可</view>
      </view>

      <view class="card-footer">
        <view class="btn-primary update-btn" bindtap="onUpdateTips">
          <text wx:if="{{updating}}">更新中…</text>
          <text wx:else>更新提示</text>
        </view>
      </view>
    </view>

    <!-- 快捷提问入口 -->
    <view class="ask-section">
      <view class="btn-primary ask-btn" bindtap="onAsk">
        <text class="ask-icon">💬</text>
        <text>我要提问</text>
      </view>
    </view>
  </view>
</view>
