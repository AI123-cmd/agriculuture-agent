@import '../../styles/tokens.wxss';
/*index.wxss*/
page {
  background: var(--bg-page);
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* —— 固定顶部用户栏 —— */
.header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: linear-gradient(150deg, #43a047 0%, #2e7d32 55%, #1f5c24 100%);
  padding: 24rpx 30rpx;
  padding-top: calc(110rpx + env(safe-area-inset-top));
  padding-bottom: 32rpx;
  min-height: calc(230rpx + env(safe-area-inset-top));
  z-index: 100;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 0 0 36rpx 36rpx;
}

/* 头部装饰圆：纯装饰图形 */
.header-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.deco-1 {
  width: 220rpx;
  height: 220rpx;
  right: -60rpx;
  top: -80rpx;
}

.deco-2 {
  width: 120rpx;
  height: 120rpx;
  right: 130rpx;
  bottom: -50rpx;
  background: rgba(255, 255, 255, 0.06);
}

.header-main {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 1;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.user-detail {
  margin-left: 24rpx;
  margin-right: auto;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  background: #ffffff;
  flex-shrink: 0;
}

.crop-name {
  font-size: var(--font-body);
  color: #ffffff;
  font-weight: 600;
  line-height: var(--line-body);
}

.farmer-name {
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
  line-height: var(--line-body);
}

/* 小禾迎宾 */
.mascot-wrap {
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* —— 滚动内容区域 —— */
.page-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-top: calc(290rpx + env(safe-area-inset-top));
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  padding-left: 30rpx;
  padding-right: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* —— 地点信息 —— */
.location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--tap-min);
}

.location-left {
  display: flex;
  align-items: center;
}

.location-pin {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50% 50% 50% 0;
  background: #2e7d32;
  transform: rotate(-45deg);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.location-name {
  font-size: var(--font-body);
  font-weight: 600;
  color: #2e7d32;
  line-height: var(--line-body);
}

.location-set {
  font-size: var(--font-caption);
  color: #2e7d32;
  font-weight: 500;
}

/* —— 环境一行状态：只读，不可点击 —— */
.env-line {
  display: flex;
  align-items: center;
}

.env-line-text {
  font-size: var(--font-body);
  color: var(--text-body);
  line-height: var(--line-body);
}

/* —— 提示卡片 —— */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-heading);
}

.card-badge {
  font-size: var(--font-caption);
  color: #b07d2b;
  background: linear-gradient(135deg, #fdf3d8, #f8e3ae);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  font-weight: 500;
}

.tip-list {
  display: flex;
  flex-direction: column;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-divider);
}

.tip-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.tip-item:first-child {
  padding-top: 0;
}

.tip-body {
  flex: 1;
  min-width: 0;
}

.tip-callout {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--text-primary);
  line-height: var(--line-tight);
}

.tip-fact {
  font-size: var(--font-body);
  color: var(--text-body);
  line-height: var(--line-body);
}

.tip-impact {
  font-size: var(--font-caption);
  color: var(--text-muted);
  line-height: var(--line-body);
}

.tip-action {
  font-size: var(--font-body);
  color: var(--text-brand);
  font-weight: 600;
  line-height: var(--line-body);
}

.tip-done .tip-callout,
.tip-done .tip-fact,
.tip-done .tip-impact,
.tip-done .tip-action {
  color: var(--text-muted);
  font-weight: 400;
}

.tip-actions {
  display: flex;
  align-items: center;
  gap: var(--space-inline);
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 朗读触发位：容器由 T4-03 预留，行为由 T4-04 实现 */
.tip-read-btn {
  border-radius: 50%;
  background: #e8f5e9;
}

.tip-read-icon {
  font-size: var(--font-caption);
  color: #2e7d32;
  font-weight: 600;
}

.tip-check-done {
  background: linear-gradient(135deg, #43a047, #2e7d32);
  border-color: transparent;
}

.tip-check-done .check-icon {
  color: #ffffff;
}

.tip-empty {
  font-size: var(--font-body);
  color: var(--text-muted);
  line-height: var(--line-body);
  padding: 16rpx 0;
}

.card-footer {
  margin-top: var(--space-heading);
}

.update-btn {
  width: 100%;
  color: #ffffff;
  background: linear-gradient(135deg, #43a047, #2e7d32);
}

/* —— 核心动作：我要提问 —— */
.ask-btn {
  width: 100%;
  color: #ffffff;
  background: linear-gradient(135deg, #43a047, #2e7d32);
  box-shadow: 0 8rpx 20rpx rgba(46, 125, 50, 0.25);
}
