@import '../../styles/tokens.wxss';

page {
  background: var(--bg-page);
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ========== 沉浸式顶部区域 ========== */
.hero-section {
  position: relative;
  padding-top: calc(120rpx + env(safe-area-inset-top));
  padding-bottom: 48rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--grad-header);
  border-radius: 0 0 48rpx 48rpx;
}

.hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.deco-1 {
  width: 280rpx;
  height: 280rpx;
  right: -80rpx;
  top: -100rpx;
}

.deco-2 {
  width: 160rpx;
  height: 160rpx;
  right: 140rpx;
  bottom: -60rpx;
  background: rgba(255, 255, 255, 0.05);
}

.deco-3 {
  width: 100rpx;
  height: 100rpx;
  left: 60rpx;
  top: 40rpx;
  background: rgba(255, 255, 255, 0.04);
}

.hero-content {
  position: relative;
  z-index: 1;
}

/* ---- 用户卡片 ---- */
.user-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.user-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  background: #ffffff;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.user-detail {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}

.user-crop {
  font-size: var(--font-title);
  color: #ffffff;
  font-weight: 700;
  line-height: var(--line-tight);
  margin-bottom: 6rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.user-name {
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.9);
  line-height: var(--line-body);
}

.mascot-wrap {
  flex-shrink: 0;
  margin-left: 20rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.15));
}

/* ---- 信息卡片组 ---- */
.info-cards {
  display: flex;
  gap: 20rpx;
}

.info-card {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  min-height: 120rpx;
}

.info-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.info-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.location-icon {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
}

.env-icon {
  background: linear-gradient(135deg, #fff3e0, #ffe0b2);
}

.pin {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50% 50% 50% 0;
  background: #2e7d32;
  transform: rotate(-45deg);
}

.env-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9800, #f57c00);
}

.info-content {
  flex: 1;
  min-width: 0;
}

.info-label {
  font-size: var(--font-caption);
  color: var(--text-muted);
  line-height: var(--line-body);
  margin-bottom: 4rpx;
}

.info-value {
  font-size: var(--font-body);
  color: var(--text-primary);
  font-weight: 600;
  line-height: var(--line-body);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.env-value {
  font-size: var(--font-caption);
  color: var(--text-body);
}

.info-arrow {
  font-size: 40rpx;
  color: var(--text-muted);
  margin-left: 12rpx;
  font-weight: 300;
}

/* ========== 主内容区 ========== */
.main-content {
  flex: 1;
  padding: 0 30rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  margin-top: -24rpx;
  position: relative;
  z-index: 2;
}

/* ---- 今日提示卡片 ---- */
.tips-card {
  background: var(--bg-card);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(46, 125, 50, 0.08);
  box-sizing: border-box;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-heading);
}

.card-title-wrap {
  display: flex;
  align-items: center;
}

.card-title-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.card-title {
  font-size: var(--font-heading);
  color: var(--text-brand);
  font-weight: 700;
  line-height: var(--line-tight);
}

.card-badge {
  font-size: var(--font-caption);
  color: #b07d2b;
  background: linear-gradient(135deg, #fdf3d8, #f8e3ae);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  font-weight: 500;
}

/* ---- 提示列表 ---- */
.tip-list {
  display: flex;
  flex-direction: column;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line-divider);
}

.tip-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.tip-item:first-child {
  padding-top: 0;
}

.tip-body {
  flex: 1;
  min-width: 0;
}

.tip-callout {
  display: flex;
  align-items: center;
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--text-primary);
  line-height: var(--line-tight);
  margin-bottom: 8rpx;
}

.tip-callout::before {
  content: '';
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--grad-brand);
  margin-right: 14rpx;
  flex-shrink: 0;
}

.tip-fact {
  font-size: var(--font-body);
  color: var(--text-body);
  line-height: var(--line-body);
  margin-bottom: 6rpx;
}

.tip-impact {
  font-size: var(--font-caption);
  color: var(--text-muted);
  line-height: var(--line-body);
  margin-bottom: 8rpx;
}

.tip-action {
  font-size: var(--font-body);
  color: var(--text-brand);
  font-weight: 600;
  line-height: var(--line-body);
}

.tip-done .tip-callout,
.tip-done .tip-fact,
.tip-done .tip-impact,
.tip-done .tip-action {
  color: var(--text-muted);
  font-weight: 400;
}

.tip-done .tip-callout::before {
  background: #c9d4c0;
}

.tip-actions {
  display: flex;
  align-items: center;
  gap: var(--space-inline);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ---- 空状态 ---- */
.tip-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: var(--font-body);
  color: var(--text-body);
  line-height: var(--line-body);
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: var(--font-caption);
  color: var(--text-muted);
  line-height: var(--line-body);
}

/* ---- 卡片底部按钮 ---- */
.card-footer {
  margin-top: var(--space-heading);
}

.update-btn {
  width: 100%;
}

/* ---- 提问区域 ---- */
.ask-section {
  margin-top: var(--space-block);
}

.ask-btn {
  width: 100%;
  height: 112rpx;
  border-radius: 56rpx;
  font-size: var(--font-title);
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 28rpx rgba(46, 125, 50, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.ask-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.2);
}

.ask-icon {
  font-size: 40rpx;
}

/* ---- 覆盖公共样式，增强视觉效果 ---- */
.btn-primary {
  border-radius: 20rpx;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.btn-primary:active {
  transform: scale(0.96);
}

.tip-read-btn {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  transition: transform 0.15s ease;
}

.tip-read-btn:active {
  transform: scale(0.9);
}

.check-circle {
  transition: all 0.2s ease;
}

.check-circle:active {
  transform: scale(0.9);
}

.tip-check-done {
  background: var(--grad-brand);
  border-color: transparent;
}

.tip-check-done .check-icon {
  color: #ffffff;
}
