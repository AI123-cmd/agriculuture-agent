@import '../../styles/tokens.wxss';
/* pages/device/list.wxss */
.page {
  min-height: 100vh;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
}

/* —— 顶部导航 —— */
.header {
  position: relative;
  background: var(--grad-header);
  color: #fff;
  padding: calc(80rpx + env(safe-area-inset-top)) 30rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.18);
  overflow: hidden;
}

.header-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.deco-1 {
  width: 200rpx;
  height: 200rpx;
  right: -40rpx;
  top: -60rpx;
}

.deco-2 {
  width: 100rpx;
  height: 100rpx;
  right: 120rpx;
  bottom: -30rpx;
  background: rgba(255, 255, 255, 0.06);
}

.back-btn,
.header-title,
.add-btn {
  position: relative;
  z-index: 1;
}

.back-btn {
  color: #fff;
  font-size: var(--font-display);
  line-height: var(--line-tight);
  width: var(--tap-min);
  height: var(--tap-min);
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

.add-btn {
  color: #fff;
}

.add-icon {
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

/* —— 滚动区域 —— */
.scroll-area {
  flex: 1;
  padding: 0 30rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* —— 空态 —— */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #e8f5e9;
  margin-bottom: 28rpx;
  position: relative;
}

.empty-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #a5d6a7;
  border-radius: 12rpx;
}

.empty-title {
  margin-bottom: 12rpx;
}

.empty-desc {
  text-align: center;
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 100%;
}

/* —— 设备卡片 —— */
.device-card {
  display: flex;
  flex-direction: column;
}

.device-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.device-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-state {
  font-size: var(--font-caption);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.state-online {
  color: #4caf50;
  background: #e8f5e9;
}

.state-offline {
  color: #595959;
  background: #f5f5f5;
}

.state-fault {
  color: #f57c00;
  background: #fff3e0;
}

.device-meta {
  margin-top: 6rpx;
}

.device-tag {
  margin-top: 20rpx;
  align-self: flex-start;
  font-size: var(--font-caption);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.tag-ready {
  color: var(--text-brand);
  background: #e8f5e9;
}

.tag-pending {
  color: #f57c00;
  background: #fff3e0;
}

.device-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.act-btn {
  flex: 1;
  height: var(--tap-min);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: var(--font-body);
  font-weight: 500;
  box-sizing: border-box;
}

.act-continue {
  color: #fff;
  background: var(--grad-brand);
  box-shadow: var(--shadow-btn);
}

.act-unbind {
  color: #d32f2f;
  background: #fff;
  border: 2rpx solid #ffcdd2;
}

.act-btn:active {
  opacity: 0.88;
}

.footer-tip {
  text-align: center;
  margin-top: 40rpx;
}

.bottom-placeholder {
  height: 40rpx;
}
