@import '../../styles/tokens.wxss';
/* pages/device/bind.wxss */
.page {
  min-height: 100vh;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
}

/* —— 顶部导航 —— */
.header {
  position: relative;
  background: var(--grad-header);
  color: #fff;
  padding: calc(80rpx + env(safe-area-inset-top)) 30rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.18);
  overflow: hidden;
}

.header-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.deco-1 {
  width: 200rpx;
  height: 200rpx;
  right: -40rpx;
  top: -60rpx;
}

.deco-2 {
  width: 100rpx;
  height: 100rpx;
  right: 120rpx;
  bottom: -30rpx;
  background: rgba(255, 255, 255, 0.06);
}

.back-btn,
.header-title,
.back-placeholder {
  position: relative;
  z-index: 1;
}

.back-btn,
.back-placeholder {
  width: var(--tap-min);
  height: var(--tap-min);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn {
  color: #fff;
  font-size: var(--font-display);
  line-height: var(--line-tight);
}

.header-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

/* —— 步骤指示 —— */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 40rpx 8rpx;
  gap: 8rpx;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #d5e4d2;
  color: #7a8a77;
  font-size: var(--font-caption);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.step-item.active .step-dot {
  background: var(--grad-brand);
  color: #fff;
}

.step-label {
  font-size: var(--font-caption);
  color: var(--text-muted);
}

.step-item.active .step-label {
  color: var(--text-brand);
  font-weight: 600;
}

.step-line {
  flex: 1;
  max-width: 120rpx;
  height: 4rpx;
  background: #d5e4d2;
  margin-bottom: 44rpx;
}

.step-line.active {
  background: #a5d6a7;
}

/* —— 滚动区域 —— */
.scroll-area {
  flex: 1;
  padding: 0 30rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hint {
  margin-bottom: 24rpx;
}

.hint.warn {
  color: #f57c00;
  margin-bottom: 0;
  margin-top: 16rpx;
}

/* —— 步骤一：输入 —— */
.sn-input {
  height: var(--btn-primary-height);
  background: #f5f8f4;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  color: var(--text-body);
}

/* —— 步骤二：配置信息 —— */
.kv-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef2e9;
  gap: 16rpx;
}

.kv-row:last-child {
  border-bottom: none;
}

.kv-label {
  flex-shrink: 0;
  width: 140rpx;
}

.kv-value {
  flex: 1;
  word-break: break-all;
  color: var(--text-brand);
  font-weight: 500;
}

.kv-copy {
  flex-shrink: 0;
  font-size: var(--font-caption);
  color: #fff;
  background: #a5d6a7;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.payload-input {
  width: 100%;
  min-height: 260rpx;
  background: #f5f8f4;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  color: var(--text-body);
}

.error-text {
  color: #d32f2f;
  margin-top: 16rpx;
  line-height: var(--line-body);
}

/* —— 步骤三：字段映射 —— */
.field-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef2e9;
}

.field-row:last-child {
  border-bottom: none;
}

.field-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.field-raw {
  font-weight: 600;
  color: var(--text-primary);
}

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  background: #f5f8f4;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  color: var(--text-body);
}

.field-picker .placeholder {
  color: var(--text-muted);
}

.picker-arrow {
  color: var(--text-muted);
  font-size: var(--font-title);
}

/* —— 提交按钮 —— */
.submit-btn {
  margin-top: 40rpx;
}

.submit-btn.disabled {
  opacity: 0.6;
}

/* —— 完成页 —— */
.result-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}

.result-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--grad-brand);
  color: #fff;
  font-size: var(--font-display);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.result-title {
  margin-bottom: 8rpx;
}

.result-desc {
  margin-bottom: 16rpx;
}

.warn-list {
  width: 100%;
  margin-top: 8rpx;
}

.preview-title {
  align-self: flex-start;
  margin-top: 32rpx;
  margin-bottom: 12rpx;
}

.preview-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef2e9;
}

.preview-row:last-child {
  border-bottom: none;
}

.preview-value {
  font-weight: 600;
  color: var(--text-brand);
}

.bottom-placeholder {
  height: 40rpx;
}
