<!--pages/env/env.wxml-->
<view class="page">
  <!-- 顶部导航 -->
  <view class="header">
    <view class="header-deco deco-1"></view>
    <view class="header-deco deco-2"></view>
    <view class="back-btn" bindtap="goBack">‹</view>
    <view class="header-title">环境监测</view>
    <view class="refresh-btn" bindtap="refreshData">
      <view class="refresh-icon {{loading ? 'spin' : ''}}"></view>
    </view>
  </view>

  <scroll-view scroll-y class="scroll-area">
    <!-- 地点信息 -->
    <view class="location-bar block" bindtap="goToLocation">
      <view class="location-left">
        <view class="location-pin"></view>
        <text class="location-name">{{locationName}}</text>
      </view>
      <text class="location-set">设置 ›</text>
    </view>

    <!-- 来源标注 -->
    <view class="source-bar block" wx:if="{{sourceLabel}}">
      <text class="source-label t-caption">{{sourceLabel}}</text>
      <text class="source-note t-caption" wx:if="{{sourceNote}}">{{sourceNote}}</text>
    </view>

    <!-- 看板指标行（含阈值状态与读数质量） -->
    <view class="card block" wx:if="{{boardMetrics.length > 0}}">
      <view class="card-title">环境看板</view>
      <view class="board-row {{item.weak ? 'board-weak' : ''}}" wx:for="{{boardMetrics}}" wx:key="metric">
        <text class="board-label t-body">{{item.label}}</text>
        <view class="board-right">
          <text class="board-value t-body">{{item.value}}<text class="board-unit t-caption">{{item.unit}}</text></text>
          <text class="board-status {{item.statusClass}}" wx:if="{{item.statusLabel}}">{{item.statusLabel}}</text>
        </view>
      </view>
    </view>

    <!-- 仪表盘 -->
    <view class="dashboard block">
      <view class="metric-card" wx:for="{{metrics}}" wx:key="id">
        <view class="metric-icon metric-icon-{{item.id}}"></view>
        <view class="metric-value">{{item.value}}<text class="metric-unit t-caption">{{item.unit}}</text></view>
        <view class="metric-label t-caption">{{item.label}}</view>
      </view>
    </view>

    <!-- 空气环境 -->
    <view class="card block">
      <view class="card-title">空气环境</view>
      <view class="data-row" wx:for="{{airData}}" wx:key="label">
        <text class="data-label">{{item.label}}</text>
        <text class="data-value">{{item.value}}</text>
      </view>
    </view>

    <!-- 土壤数据 -->
    <view class="card block">
      <view class="card-title">土壤数据</view>
      <view class="data-row" wx:for="{{soilData}}" wx:key="label">
        <text class="data-label">{{item.label}}</text>
        <text class="data-value">{{item.value}}</text>
      </view>
    </view>

    <!-- 光照与气象 -->
    <view class="card block">
      <view class="card-title">光照与气象</view>
      <view class="data-row" wx:for="{{weatherData}}" wx:key="label">
        <text class="data-label">{{item.label}}</text>
        <text class="data-value">{{item.value}}</text>
      </view>
    </view>

    <!-- 设备状态 -->
    <view class="card block">
      <view class="card-title">设备状态</view>
      <view class="device-empty" wx:if="{{devices.length === 0}}">暂无绑定设备</view>
      <view class="device-row" wx:for="{{devices}}" wx:key="id">
        <view class="device-dot {{item.dotClass}}"></view>
        <view class="device-info">
          <text class="device-name">{{item.name}}</text>
          <text class="device-time">{{item.timeLabel}}</text>
        </view>
        <text class="device-state {{item.stateClass}}">{{item.stateLabel}}</text>
      </view>
    </view>

    <!-- 底部更新时间 -->
    <view class="footer-info">
      <text class="footer-text">最后更新：{{lastUpdateAt}}</text>
      <view class="footer-refresh" bindtap="refreshData">刷新数据</view>
    </view>

    <view class="footer-placeholder"></view>
  </scroll-view>
</view>
