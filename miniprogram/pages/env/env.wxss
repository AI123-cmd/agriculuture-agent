/* pages/env/env.wxss */
.page {
  min-height: 100vh;
  background: #f0f4ea;
  display: flex;
  flex-direction: column;
}

/* —— 顶部导航 —— */
.header {
  background: linear-gradient(150deg, #43a047 0%, #2e7d32 55%, #1f5c24 100%);
  color: #fff;
  padding: calc(80rpx + env(safe-area-inset-top)) 30rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border-radius: 0 0 36rpx 36rpx;
}

.back-btn {
  color: #fff;
  font-size: 56rpx;
  line-height: 1;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.refresh-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.refresh-icon {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  border-top-color: transparent;
}

.refresh-icon.spin {
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* —— 滚动区域 —— */
.scroll-area {
  flex: 1;
  padding: 0 30rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* —— 模块间距 —— */
.item-block {
  margin-top: 32rpx;
}

.item-block:first-child {
  margin-top: 0;
}

/* —— 地点信息 —— */
.location-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.location-left {
  display: flex;
  align-items: center;
}

.location-pin {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50% 50% 50% 0;
  background: #2e7d32;
  transform: rotate(-45deg);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.location-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2e7d32;
}

.location-set {
  font-size: 26rpx;
  color: #2e7d32;
  font-weight: 500;
}

/* —— 仪表盘（4项合入1卡片，紧凑2×2） —— */
.dashboard {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.06);
}

.metric-card {
  background: transparent;
  padding: 14rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  border-right: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 去掉右列右边框、末行下边框 */
.metric-card:nth-child(2n) {
  border-right: none;
}
.metric-card:nth-last-child(-n+2) {
  border-bottom: none;
}

.metric-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 温度图标 */
.metric-icon-temp {
  background: #fff3e0;
}
.metric-icon-temp::after {
  content: '';
  width: 6rpx;
  height: 20rpx;
  background: #ff9800;
  border-radius: 4rpx;
}

/* 湿度图标 */
.metric-icon-humidity {
  background: #e3f2fd;
}
.metric-icon-humidity::after {
  content: '';
  width: 12rpx;
  height: 16rpx;
  background: #1976d2;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

/* 土壤图标 */
.metric-icon-soil {
  background: #efebe9;
}
.metric-icon-soil::after {
  content: '';
  width: 18rpx;
  height: 12rpx;
  background: #795548;
  border-radius: 4rpx;
}

/* 光照图标 */
.metric-icon-light {
  background: #fffde7;
}
.metric-icon-light::after {
  content: '';
  width: 15rpx;
  height: 15rpx;
  background: #fbc02d;
  border-radius: 50%;
}

.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.2;
}

.metric-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #999;
  margin-left: 2rpx;
}

.metric-label {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}

/* —— 数据卡片 —— */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.06);
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2e4632;
  margin-bottom: 24rpx;
}

.data-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.data-row:last-child {
  border-bottom: none;
}

.data-label {
  font-size: 28rpx;
  color: #666;
}

.data-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* —— 设备状态 —— */
.device-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 20rpx;
}

.device-row:last-child {
  border-bottom: none;
}

.device-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.device-dot.online {
  background: #4caf50;
  box-shadow: 0 0 8rpx rgba(76, 175, 80, 0.4);
}

.device-dot.offline {
  background: #ccc;
}

.device-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.device-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.device-time {
  font-size: 24rpx;
  color: #999;
}

.device-state {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.state-online {
  color: #4caf50;
  background: #e8f5e9;
}

.state-offline {
  color: #999;
  background: #f5f5f5;
}

/* —— 底部 —— */
.footer-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 40rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}

.footer-refresh {
  font-size: 26rpx;
  color: #2e7d32;
  font-weight: 500;
  padding: 8rpx 24rpx;
  border: 1rpx solid #2e7d32;
  border-radius: 24rpx;
}

.footer-placeholder {
  height: 40rpx;
}
