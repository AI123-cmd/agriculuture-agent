@import '../../styles/tokens.wxss';
/* pages/env/env.wxss */
.page {
  min-height: 100vh;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
}

/* —— 顶部导航 —— */
.header {
  position: relative;
  background: var(--grad-header);
  color: #fff;
  padding: calc(80rpx + env(safe-area-inset-top)) 30rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.18);
  overflow: hidden;
}

/* 头部装饰圆：纯装饰图形 */
.header-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.deco-1 {
  width: 200rpx;
  height: 200rpx;
  right: -40rpx;
  top: -60rpx;
}

.deco-2 {
  width: 100rpx;
  height: 100rpx;
  right: 120rpx;
  bottom: -30rpx;
  background: rgba(255, 255, 255, 0.06);
}

.back-btn,
.header-title,
.refresh-btn {
  position: relative;
  z-index: 1;
}

.back-btn {
  color: #fff;
  font-size: var(--font-display);
  line-height: var(--line-tight);
  width: var(--tap-min);
  height: var(--tap-min);
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

.refresh-btn {
  width: var(--tap-min);
  height: var(--tap-min);
  display: flex;
  align-items: center;
  justify-content: center;
}

.refresh-icon {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  border-top-color: transparent;
}

.refresh-icon.spin {
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* —— 滚动区域 —— */
.scroll-area {
  flex: 1;
  padding: 0 30rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* —— 模块间距由公共类 .block 提供（app.wxss），此处不再定义 —— */

/* —— 地点信息 —— */
.location-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.location-left {
  display: flex;
  align-items: center;
}

.location-pin {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50% 50% 50% 0;
  background: #2e7d32;
  transform: rotate(-45deg);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.location-name {
  font-size: var(--font-title);
  font-weight: 600;
  color: #2e7d32;
}

.location-set {
  font-size: var(--font-caption);
  color: #2e7d32;
  font-weight: 500;
}

/* —— 仪表盘（4项合入1卡片，紧凑2×2） —— */
.dashboard {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.06);
}

.metric-card {
  background: transparent;
  padding: 14rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  border-right: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 去掉右列右边框、末行下边框 */
.metric-card:nth-child(2n) {
  border-right: none;
}
.metric-card:nth-last-child(-n+2) {
  border-bottom: none;
}

.metric-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 温度图标 */
.metric-icon-temp {
  background: #fff3e0;
}
.metric-icon-temp::after {
  content: '';
  width: 6rpx;
  height: 20rpx;
  background: #ff9800;
  border-radius: 4rpx;
}

/* 湿度图标 */
.metric-icon-humidity {
  background: #e3f2fd;
}
.metric-icon-humidity::after {
  content: '';
  width: 12rpx;
  height: 16rpx;
  background: #1976d2;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

/* 土壤图标 */
.metric-icon-soil {
  background: #efebe9;
}
.metric-icon-soil::after {
  content: '';
  width: 18rpx;
  height: 12rpx;
  background: #795548;
  border-radius: 4rpx;
}

/* 光照图标 */
.metric-icon-light {
  background: #fffde7;
}
.metric-icon-light::after {
  content: '';
  width: 15rpx;
  height: 15rpx;
  background: #fbc02d;
  border-radius: 50%;
}

.metric-value {
  font-size: var(--font-body);
  font-weight: 700;
  color: #333;
  line-height: var(--line-tight);
}

.metric-unit {
  font-weight: 400;
  color: #595959;
  margin-left: 2rpx;
}

.metric-label {
  color: #595959;
  margin-top: 4rpx;
}

/* —— 数据卡片：.card / .card-title 使用 app.wxss 公共类 —— */

.data-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.data-row:last-child {
  border-bottom: none;
}

.data-label {
  font-size: var(--font-body);
  color: #595959;
}

.data-value {
  font-size: var(--font-body);
  font-weight: 600;
  color: #333;
}

/* —— 设备状态 —— */
.device-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 20rpx;
}

.device-row:last-child {
  border-bottom: none;
}

.device-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.device-dot.online {
  background: #4caf50;
  box-shadow: 0 0 8rpx rgba(76, 175, 80, 0.4);
}

.device-dot.offline {
  background: #ccc;
}

.device-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.device-name {
  font-size: var(--font-body);
  color: #333;
  font-weight: 500;
}

.device-time {
  font-size: var(--font-caption);
  color: #595959;
}

.device-state {
  font-size: var(--font-caption);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.state-online {
  color: #4caf50;
  background: #e8f5e9;
}

.state-offline {
  color: #595959;
  background: #f5f5f5;
}

/* —— 底部 —— */
.footer-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 40rpx;
}

.footer-text {
  font-size: var(--font-caption);
  color: #595959;
}

.footer-refresh {
  font-size: var(--font-body);
  color: #2e7d32;
  font-weight: 500;
  padding: 8rpx 24rpx;
  min-height: var(--tap-min);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #2e7d32;
  border-radius: 24rpx;
}

.footer-placeholder {
  height: 40rpx;
}
