<!-- components/nav-bar/index.wxml -->
<view class="nav-wrapper {{theme}}" style="background: {{background}};">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <!-- 左侧：返回按钮或占位 -->
    <view class="nav-side nav-left" style="width: {{sideWidth}}px;">
      <view wx:if="{{showBack}}" class="back-btn tap-88" bindtap="onBack">
        <view class="back-arrow"></view>
      </view>
    </view>

    <!-- 中间标题 -->
    <view class="nav-title">{{title}}</view>

    <!-- 右侧：与左侧同宽，对称占位 -->
    <view class="nav-side nav-right" style="width: {{sideWidth}}px;"></view>
  </view>
</view>
