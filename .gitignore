# 敏感配置与运行时产物（.env 含真实密钥，严禁提交）
.env
.env.*
!.env.example
# Langfuse 部署模板（T6-07）：与 .env.example 同理，只提交无真实值的模板
!deploy/langfuse/.env.langfuse.example
*.local.env
# Compose 本地覆盖（T6-10）：只提交 .example，运行时覆盖文件因环境而异
docker-compose.override.yml
backend/uploads/
backend/_mig_test.db
backend/agent_checkpoints.db
backend/agent_checkpoints.db-wal
backend/agent_checkpoints.db-shm

# 密钥 / 证书 / 凭据（严禁提交）
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.p8
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_dsa
credentials*.json
client_secret*.json
service-account*.json

# 数据库与备份
*.sql
*.dump
*.bak
# 例外：PostgreSQL 容器首次初始化的建扩展脚本（T6-10）是源码而非备份，须纳入版本控制
!deploy/postgres/init/*.sql

